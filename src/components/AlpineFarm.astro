<script>
  const root = document.getElementById('farm');
  if (root) {
    const levels = Array.from(root.querySelectorAll<SVGSVGElement>('svg.lvl'));
    const texts = Array.from(root.querySelectorAll<HTMLElement>('[data-text]'));
    const scales = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-go]'));
    const zoomBtn = root.querySelector<HTMLButtonElement>('[data-zoom]')!;
    const zoomLabel = root.querySelector<HTMLElement>('[data-zoom-label]')!;
    const cap = root.querySelector<HTMLElement>('[data-stage-cap]')!;
    const meta = [
      { scale: '1 : 1,000,000', name: 'Region', next: 'Zoom into the site', origin: '52% 88%' },
      { scale: '1 : 2,000', name: 'Site', next: 'Zoom into Grow House 2', origin: '35% 39%' },
      { scale: '1 : 100', name: 'Grow house', next: 'Zoom into the nutrient room', origin: '16% 76%' },
      { scale: '1 : 10', name: 'Nutrient loop', next: 'Back out to the region', origin: '50% 50%' },
    ];
    let cur = 1;

    const go = (n: number) => {
      const zoomingIn = n > cur;
      const from = levels[cur - 1];
      const to = levels[n - 1];
      if (from !== to) {
        from.style.transformOrigin = meta[cur - 1].origin;
        from.classList.remove('on');
        from.classList.add(zoomingIn ? 'out-in' : 'out-out');
        to.style.transformOrigin = meta[(zoomingIn ? cur : n) - 1].origin;
        to.classList.remove('out-in', 'out-out');
        to.classList.add(zoomingIn ? 'from-small' : 'from-big');
        requestAnimationFrame(() => requestAnimationFrame(() => {
          to.classList.remove('from-small', 'from-big');
          to.classList.add('on');
        }));
      }
      cur = n;
      texts.forEach((t) => (t.hidden = Number(t.dataset.text) !== n));
      scales.forEach((s) => s.setAttribute('aria-pressed', String(Number(s.dataset.go) === n)));
      zoomLabel.textContent = meta[n - 1].next;
      cap.textContent = `Scale ${meta[n - 1].scale} · ${meta[n - 1].name}`;
      root.querySelectorAll('.hs.active').forEach((h) => h.classList.remove('active'));
    };

    const openHotspot = (i: number) => {
      const panel = texts[cur - 1];
      panel.querySelectorAll<HTMLButtonElement>('[data-hs-item]').forEach((b) => {
        const on = Number(b.dataset.hsItem) === i && b.getAttribute('aria-expanded') !== 'true';
        b.setAttribute('aria-expanded', String(on));
        (b.nextElementSibling as HTMLElement).hidden = !on;
      });
      levels[cur - 1].querySelectorAll<SVGGElement>('.hs').forEach((g) => g.classList.toggle('active', Number(g.dataset.hs) === i));
    };

    levels[0].classList.add('on');
    scales.forEach((s) => s.addEventListener('click', () => go(Number(s.dataset.go))));
    zoomBtn.addEventListener('click', () => go(cur < 4 ? cur + 1 : 1));
    levels.forEach((svg) => svg.querySelectorAll<SVGGElement>('.hs').forEach((g) => {
      g.setAttribute('tabindex', '0');
      g.setAttribute('role', 'button');
      g.setAttribute('aria-label', `Detail ${g.dataset.hs}`);
      const fire = () => openHotspot(Number(g.dataset.hs));
      g.addEventListener('click', fire);
      g.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fire(); } });
    }));
    texts.forEach((t) => t.querySelectorAll<HTMLButtonElement>('[data-hs-item]').forEach((b) =>
      b.addEventListener('click', () => openHotspot(Number(b.dataset.hsItem)))));
  }
</script>

