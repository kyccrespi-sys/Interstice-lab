<script>
  const root = document.getElementById('farm');
  if (root) {
    const levels = Array.from(root.querySelectorAll<SVGSVGElement>('svg.lvl'));
    const texts = Array.from(root.querySelectorAll<HTMLElement>('[data-text]'));
    const scales = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-go]'));
    const zoomBtn = root.querySelector<HTMLButtonElement>('[data-zoom]')!;
    const zoomLabel = root.querySelector<HTMLElement>('[data-zoom-label]')!;
    const cap = root.querySelector<HTMLElement>('[data-stage-cap]')!;
    const meta = [
      { scale: '1 : 1,000,000', name: 'Region', next: 'Zoom into the site', origin: '52% 88%' },
      { scale: '1 : 2,000', name: 'Site', next: 'Zoom into Grow House 2', origin: '35% 39%' },
      { scale: '1 : 100', name: 'Grow house', next: 'Zoom into the nutrient room', origin: '16% 76%' },
      { scale: '1 : 10', name: 'Nutrient loop', next: 'Back out to the region', origin: '50% 50%' },
    ];
    let cur = 1;

    const go = (n: number) => {
      const zoomingIn = n > cur;
      const from = levels[cur - 1];
      const to = levels[n - 1];
      if (from !== to) {
        from.style.transformOrigin = meta[cur - 1].origin;
        from.classList.remove('on');
        from.classList.add(zoomingIn ? 'out-in' : 'out-out');
        to.style.transformOrigin = meta[(zoomingIn ? cur : n) - 1].origin;
        to.classList.remove('out-in', 'out-out');
        to.classList.add(zoomingIn ? 'from-small' : 'from-big');
        requestAnimationFrame(() => requestAnimationFrame(() => {
          to.classList.remove('from-small', 'from-big');
          to.classList.add('on');
        }));
      }
      cur = n;
      texts.forEach((t) => (t.hidden = Number(t.dataset.text) !== n));
      scales.forEach((s) => s.setAttribute('aria-pressed', String(Number(s.dataset.go) === n)));
      zoomLabel.textContent = meta[n - 1].next;
      cap.textContent = `Scale ${meta[n - 1].scale} · ${meta[n - 1].name}`;
      root.querySelectorAll('.hs.active').forEach((h) => h.classList.remove('active'));
    };

    const openHotspot = (i: number) => {
      const panel = texts[cur - 1];
      panel.querySelectorAll<HTMLButtonElement>('[data-hs-item]').forEach((b) => {
        const on = Number(b.dataset.hsItem) === i && b.getAttribute('aria-expanded') !== 'true';
        b.setAttribute('aria-expanded', String(on));
        (b.nextElementSibling as HTMLElement).hidden = !on;
      });
      levels[cur - 1].querySelectorAll<SVGGElement>('.hs').forEach((g) => g.classList.toggle('active', Number(g.dataset.hs) === i));
    };

    levels[0].classList.add('on');
    scales.forEach((s) => s.addEventListener('click', () => go(Number(s.dataset.go))));
    zoomBtn.addEventListener('click', () => go(cur < 4 ? cur + 1 : 1));
    levels.forEach((svg) => svg.querySelectorAll<SVGGElement>('.hs').forEach((g) => {
      g.setAttribute('tabindex', '0');
      g.setAttribute('role', 'button');
      g.setAttribute('aria-label', `Detail ${g.dataset.hs}`);
      const fire = () => openHotspot(Number(g.dataset.hs));
      g.addEventListener('click', fire);
      g.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fire(); } });
    }));
    texts.forEach((t) => t.querySelectorAll<HTMLButtonElement>('[data-hs-item]').forEach((b) =>
      b.addEventListener('click', () => openHotspot(Number(b.dataset.hsItem)))));
  }
</script>

<style>
  .farm { display: flex; flex-direction: column; gap: 32px; }
  .stack { display: flex; flex-direction: column; gap: 16px; max-width: 760px; }
  .farm-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px; }
  .farm-hint { max-width: 340px; }

  .scales { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .scale { min-height: 64px; padding: 10px 16px; border-radius: 16px; border: 1px solid rgba(35,32,26,0.2); background: var(--card); color: var(--ink); display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 2px; cursor: pointer; text-align: left; font-family: var(--sans); transition: background .25s ease, color .25s ease; }
  .scale[aria-pressed='true'] { background: var(--ink); color: var(--ground); border-color: var(--ink); }
  .scale-n { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; opacity: 0.75; }
  .scale-name { font-size: 17px; font-weight: 400; }
  @media (max-width: 640px) { .scales { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .farm-body { display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-start; }
  .stage-col { flex: 1 1 600px; min-width: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }
  .stage { position: relative; width: 100%; aspect-ratio: 1000 / 625; border-radius: 6px; overflow: hidden; background: #12110E; box-shadow: 0 30px 80px -40px rgba(18,17,14,.7); }
  .stage :global(svg.lvl) { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; transition: opacity .7s ease, transform .9s cubic-bezier(.2,.7,.2,1); }
  .stage :global(svg.lvl.on) { opacity: 1; transform: scale(1); pointer-events: auto; }
  .stage :global(svg.lvl.out-in) { opacity: 0; transform: scale(3.2); }
  .stage :global(svg.lvl.out-out) { opacity: 0; transform: scale(0.35); }
  .stage :global(svg.lvl.from-small) { opacity: 0; transform: scale(0.35); transition: none; }
  .stage :global(svg.lvl.from-big) { opacity: 0; transform: scale(3.2); transition: none; }

  .stage :global(.hs) { cursor: pointer; }
  .stage :global(.hs-dot) { fill: #12110E; stroke: #E8A33D; stroke-width: 1; transition: fill .2s ease; }
  .stage :global(.hs-num-t) { fill: #E8A33D; font-weight: 500; transition: fill .2s ease; }
  .stage :global(.hs:hover .hs-num-t), .stage :global(.hs.active .hs-num-t), .stage :global(.hs:focus-visible .hs-num-t) { fill: #12110E; }
  .stage :global(.hs-ring) { fill: none; stroke: #E8A33D; stroke-width: 0.8; opacity: .9; transform-box: fill-box; transform-origin: center; animation: pulse 2.4s ease-out infinite; }
  .stage :global(.hs:hover .hs-dot), .stage :global(.hs:focus-visible .hs-dot), .stage :global(.hs.active .hs-dot) { fill: #E8A33D; }
  .stage :global(.hs:focus) { outline: none; }
  .stage :global(.hs:focus-visible .hs-ring) { stroke: #EDE6DA; stroke-width: 1.5; }
  .stage :global(.target) { animation: glow 3s ease-in-out infinite; }
  .stage :global(.flow) { stroke-dasharray: 6 6; animation: flow 1.6s linear infinite; }
  .stage :global(.flow-slow) { stroke-dasharray: 10 8; animation: flow 4s linear infinite; }
  .stage :global(.spin) { transform-box: fill-box; transform-origin: center; animation: spin 1.4s linear infinite; }
  @keyframes pulse { 0% { transform: scale(.8); opacity: .9; } 100% { transform: scale(1.6); opacity: 0; } }
  @keyframes glow { 50% { opacity: .55; } }
  @keyframes flow { to { stroke-dashoffset: -24; } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .stage :global(svg.lvl) { transition: opacity .3s ease; transform: none !important; }
    .stage :global(.hs-ring), .stage :global(.target), .stage :global(.flow), .stage :global(.flow-slow), .stage :global(.spin) { animation: none; }
  }

  .zoom-in { min-height: 48px; padding: 0 18px; border-radius: 999px; border: 0; background: var(--ink); color: var(--ground); font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 10px 30px -12px rgba(0,0,0,.5); }
  .stage-cap { position: absolute; left: 30px; top: 26px; margin: 0; font-family: var(--mono); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: #E8A33D; }
