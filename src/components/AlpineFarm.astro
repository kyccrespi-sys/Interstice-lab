---
// Framework 007 — a four-scale zoomable prototype of a Rocky Mountain hydroponic farm.
// Generated by gen_farm.py. Text for each level and hotspot lives in LEVELS below.
const LEVELS = [
 {
  "n": 1,
  "scale": "1 : 1,000,000",
  "name": "Region",
  "title": "A valley in the Rocky Mountains",
  "formal": "UV ↑ 10–12% per 1,000 m of altitude · water = prior appropriation",
  "analysis": "Thin air brings intense sun, cold nights and a short outdoor season. Snowpack feeds the rivers, but in Colorado, water belongs to whoever holds the oldest right.",
  "idea": "The mountains give light and heat in abundance. Water is the scarce thing.",
  "target": "Zoom into the site",
  "hs": [
   [
    "Sun at altitude",
    "UV rises roughly 10–12% with every 1,000 m of altitude (WHO). Strong light is a gift for plants, as long as the glazing manages it.",
    "WHO Global Solar UV Index"
   ],
   [
    "Snowpack and water law",
    "Colorado follows prior appropriation: first in time, first in right. A farm needs a legal water source, such as a decreed well or a purchased right; it cannot simply collect what falls.",
    "CSU Extension; Colorado DWR"
   ],
   [
    "Valley floor",
    "The site sits low in a valley, out of the worst wind, on flat ground close to a road and a town. Elevation shown is illustrative.",
    "Design assumption"
   ],
   [
    "Hot springs",
    "Many mountain towns sit on geothermal water. Pagosa Springs, Colorado, already heats growing domes with it.",
    "Geothermal Greenhouse Partnership"
   ]
  ]
 },
 {
  "n": 2,
  "scale": "1 : 2,000",
  "name": "Site",
  "title": "The campus from above",
  "formal": "Long axis east–west · heat stored, not bought · water recaptured",
  "analysis": "Three grow houses face the winter sun. Solar panels and a geothermal well charge a thermal store that heats the houses at night. A windbreak shields the north and west.",
  "idea": "A farm planned like an organism: every flow closes back on itself.",
  "target": "Zoom into Grow House 2",
  "hs": [
   [
    "Grow houses",
    "Three long houses with their glazing facing south to catch low winter sun.",
    "Design assumption"
   ],
   [
    "Solar field",
    "Daytime electricity for pumps, fans and supplemental lights.",
    "Design assumption"
   ],
   [
    "Thermal store",
    "A large insulated tank that banks daytime and geothermal heat and releases it overnight.",
    "Design assumption"
   ],
   [
    "Water store",
    "Holds water from a legal source, plus condensate recaptured from the grow houses.",
    "Design assumption"
   ],
   [
    "Windbreak",
    "Trees on the north and west edges cut wind and snow drift against the houses.",
    "Design assumption"
   ],
   [
    "Pack house and market",
    "Harvest is washed, packed and sold on site, the way Vertical Harvest runs a market in its Jackson greenhouse.",
    "Vertical Harvest"
   ]
  ]
 },
 {
  "n": 3,
  "scale": "1 : 100",
  "name": "Grow house",
  "title": "Inside a grow house",
  "formal": "Light in, heat held, water returned",
  "analysis": "A steep south roof sheds snow and catches winter sun; an insulated north wall holds heat. A thermal curtain closes at night. Three tiers of channels multiply the growing area, as Vertical Harvest does on a tenth of an acre.",
  "idea": "The building is a lung: it breathes light in by day and holds its breath at night.",
  "target": "Zoom into the nutrient room",
  "hs": [
   [
    "Steep south glazing",
    "A steep pitch lets snow slide off and meets low winter sun nearly face-on. Double-wall glazing keeps heat in.",
    "Design assumption"
   ],
   [
    "Thermal curtain",
    "A fabric screen that closes at night to hold heat in under the roof.",
    "Design assumption"
   ],
   [
    "Supplemental LEDs",
    "Top up light on short winter days. Lettuce needs a daily light integral of about 6.5–9.7 mol·m⁻²·day⁻¹.",
    "University of Kentucky CCD"
   ],
   [
    "Stacked channels",
    "Three tiers of channels on racks. Vertical Harvest's stacked, rotating system makes its growing area three times its footprint.",
    "U.S. DOE; Vertical Harvest"
   ],
   [
    "Buried heat loop",
    "Warm water from the thermal store runs under the floor and root zone.",
    "Design assumption"
   ],
   [
    "Dehumidifier",
    "Plants breathe out water. The dehumidifier pulls it from the air and sends it back to the reservoir.",
    "Design assumption"
   ],
   [
    "Nutrient room",
    "Where the water is mixed, measured and pumped.",
    ""
   ]
  ]
 },
 {
  "n": 4,
  "scale": "1 : 10",
  "name": "Nutrient loop",
  "title": "The nutrient loop",
  "formal": "pH 5.5–6.5 · dissolved oxygen 6+ ppm · EC set per crop",
  "analysis": "Water circulates in a closed loop: reservoir, pump, UV steriliser, channels and back. Sensors read pH, EC, dissolved oxygen and temperature; the controller doses nutrients A and B, or acid, to hold each in range.",
  "idea": "A closed circle of water, kept in balance by constant small corrections.",
  "target": "",
  "hs": [
   [
    "Reservoir",
    "Holds the nutrient solution. Every drop that isn't taken up by a plant comes back here.",
    "Ohio State University"
   ],
   [
    "Controller",
    "Reads the sensors and decides what to dose. The ranges shown are typical lettuce targets: pH 5.5–6.5 and dissolved oxygen of 6 ppm or more.",
    "Ohio State University"
   ],
   [
    "Dosing pumps",
    "Small pumps add nutrient concentrates A and B, or acid to lower pH. As plants feed, EC falls; as water evaporates, EC rises.",
    "USDA ARS"
   ],
   [
    "Main pump",
    "Lifts solution from the reservoir to the top of the channels.",
    "Ohio State University"
   ],
   [
    "UV steriliser",
    "Light kills microbes in the recirculating water before it reaches the roots.",
    "Design assumption"
   ],
   [
    "NFT channels",
    "Nutrient film technique: a thin stream flows past the roots in a sloped channel, and the excess drains back.",
    "Ohio State University"
   ],
   [
    "Return",
    "Gravity carries the leftover solution back to the reservoir, closing the loop.",
    "Ohio State University"
   ]
  ]
 }
