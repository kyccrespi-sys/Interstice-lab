<section id="farm" class="band-white" aria-label="Interactive prototype: zoom from the mountains to the nutrient loop">
  <div class="wrap section farm">
    <div class="farm-head">
      <div class="stack">
        <p class="label">Fig. 03 · The prototype</p>
        <h2 class="h2">From the mountains <span class="it clay">to the roots.</span></h2>
      </div>
      <p class="small farm-hint">Zoom with the scale buttons, or tap a numbered point to look closer.</p>
    </div>

    <nav class="scales" aria-label="Zoom level">
      {LEVELS.map((l) => (
        <button type="button" class="scale" data-go={l.n} aria-pressed={l.n === 1 ? 'true' : 'false'}>
          <span class="scale-n">{l.scale}</span>
          <span class="scale-name">{l.name}</span>
        </button>
      ))}
    </nav>

    <div class="farm-body">
