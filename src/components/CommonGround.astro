---
// Figures for 005 · Common Ground. Original, illustrative plan and schedules; not an architectural drawing.
import { buildIso, iso, ISO, skylights } from './cg/isoBuilding';
const zones = [
  { id: 'hall', n: 'The Nature Hall', who: 'Children · elders watch and join', x: 330, y: 150, w: 340, h: 270, c: '#E8A33D',
    t: 'An indoor play landscape built from natural materials: boulders, logs, sand and tree-trunk columns, under a ring of clerestory windows and skylights so children see the sky, clouds and weather while staying indoors. Low benches along the edges invite older adults to watch, cheer and join in.',
    e: 'Contact with nature is most strongly linked to children’s physical activity and mental health, and natural elements in early-childhood settings are linked to more active play.' },
  { id: 'yard', n: 'The Outdoor Yard', who: 'Everyone, when the door is up', x: 250, y: 470, w: 500, h: 130, c: '#6B8F4E',
    t: 'Through the roll-up door: logs to balance on, boulders to climb, a sand and mud kitchen, shade trees and raised garden beds at a height elders can work from a chair. Smooth, level paths loop through it for walkers and wheelchairs.',
    e: 'In a randomized trial, adding 40 minutes a day outdoors reduced new cases of nearsightedness in 6-year-olds over three years. Reviews find risky outdoor play good for children’s activity and confidence.' },
  { id: 'garden', n: 'The Garden Lab', who: 'Shared · STEM', x: 680, y: 150, w: 220, h: 150, c: '#3E7F8C',
    t: 'Hydroponic towers indoors, raised beds outside. Children measure, count, test water and chart growth; elders who have gardened all their lives teach. The harvest goes to the Hearth kitchen.',
    e: 'A STEM lab that also gives older adults a purposeful role. The hydroponic system can follow the design in our framework 007, Thin Air, Deep Roots.' },
  { id: 'gym', n: 'The Strength Studio', who: 'Shared · separate and together', x: 680, y: 310, w: 220, h: 110, c: '#A8432C',
    t: 'One room, two programs: balance, functional and strength training for older adults to prevent falls, and age-appropriate strength and movement for children, with some sessions where they train side by side.',
    e: 'Exercise reduces falls in older people by about a quarter, and programs combining balance, functional and resistance exercise by about a third. Supervised strength training is considered safe and effective for children.' },
  { id: 'kids', n: 'Little Ones Rooms', who: 'Children · licensed child care', x: 100, y: 150, w: 220, h: 150, c: '#D8C58E',
    t: 'Licensed classrooms grouped by age, with nap rooms and their own entry. Each opens onto the Nature Hall.',
    e: 'Child care keeps its own license, staff ratios and routines. Shared time is planned, not constant.' },
  { id: 'elders', n: 'Elder Day & Living', who: 'Older adults', x: 100, y: 310, w: 220, h: 110, c: '#B9A9C9',
    t: 'Adult day program or assisted-living apartments, with private, quiet spaces. Joining the children is always a choice, never a requirement.',
    e: 'In successful shared sites, older adults choose how much to take part.' },
  { id: 'hearth', n: 'The Hearth', who: 'Shared kitchen & dining', x: 330, y: 50, w: 340, h: 90, c: '#C77B2B',
    t: 'A shared kitchen and dining room where garden produce is cooked, and where story time, music and family events happen.',
    e: 'Sharing kitchens, facilities and staff is where most of the savings in shared sites come from.' },
  { id: 'quiet', n: 'Quiet Room', who: 'Either age', x: 100, y: 50, w: 220, h: 90, c: '#9DB57F',
    t: 'A calm, low-light room with soft natural textures for a child who is overwhelmed or an adult who needs rest.',
    e: 'Every shared site needs a way out of the bustle.' },
  { id: 'clinic', n: 'Wellness Room', who: 'Nurse · physical therapist', x: 680, y: 50, w: 220, h: 90, c: '#5B7FA6',
    t: 'Fall-risk screening, physical therapy and first aid for both ages.',
    e: 'Fall-prevention programs work best when set and progressed by trained staff.' },
];
const isoSvg = buildIso();
const zonePoly = (z: { x: number; y: number; w: number; h: number }) => [iso(z.x, z.y), iso(z.x + z.w, z.y), iso(z.x + z.w, z.y + z.h), iso(z.x, z.y + z.h)].map((p) => p.map((v) => v.toFixed(1)).join(',')).join(' ');
const labelAt = (z: { x: number; y: number }) => iso(z.x + 6, z.y + 6, 0);
---
<section class="cg" aria-labelledby="cg-h">
  <div class="wrap cg-in">
    <div class="cg-head">
      <p class="label">Figure 1 · The building</p>
      <h2 class="h2" id="cg-h">One roof, <span class="it clay">every age.</span></h2>
      <p class="body">Tap a room to see who uses it, what it’s made of and the evidence behind it. Raise the garage door, and move the sun across the day.</p>
    </div>

    <figure class="plan" id="cgplan">
      <div class="plan-ctl">
        <button type="button" class="door-btn" data-door aria-pressed="false">Raise the garage door ↑</button>
        <label class="sun-ctl"><span class="label muted">Time of day</span><input type="range" min="7" max="18" step="0.25" value="10" data-sun aria-label="Time of day" /><span class="sun-t" data-sunt>10:00</span></label>
      </div>
      <div class="plan-body">
        <svg viewBox="0 0 1200 820" role="img" aria-label="Cutaway drawing of the Common Ground building" font-family="IBM Plex Mono, monospace">
          <defs>
            <filter id="cgblur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="2.6"></feGaussianBlur></filter>
            <radialGradient id="cgstone" cx=".35" cy=".3" r=".8"><stop offset="0" stop-color="#E6E0D4"></stop><stop offset=".55" stop-color="#B8AE9E"></stop><stop offset="1" stop-color="#8C8274"></stop></radialGradient>
            <radialGradient id="cgleaf0" cx=".35" cy=".3" r=".75"><stop offset="0" stop-color="#B5D58C"></stop><stop offset=".6" stop-color="#6E9E4E"></stop><stop offset="1" stop-color="#46703A"></stop></radialGradient>
            <radialGradient id="cgleaf1" cx=".35" cy=".3" r=".75"><stop offset="0" stop-color="#A3C97C"></stop><stop offset=".6" stop-color="#5E8E44"></stop><stop offset="1" stop-color="#3E6432"></stop></radialGradient>
            <linearGradient id="cgbark" x1="0" x2="1"><stop offset="0" stop-color="#5E4128"></stop><stop offset=".35" stop-color="#9C7448"></stop><stop offset=".7" stop-color="#7A5432"></stop><stop offset="1" stop-color="#4E3520"></stop></linearGradient>
            <linearGradient id="cgpipe" x1="0" x2="1"><stop offset="0" stop-color="#C9C4BA"></stop><stop offset=".4" stop-color="#FBF9F4"></stop><stop offset="1" stop-color="#BDB7AC"></stop></linearGradient>
            <linearGradient id="cgglass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#D8EEF2"></stop><stop offset=".5" stop-color="#A9D3DC"></stop><stop offset="1" stop-color="#E8F5F7"></stop></linearGradient>
            <linearGradient id="cgdoor" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#B98A55"></stop><stop offset="1" stop-color="#8A6238"></stop></linearGradient>
            <linearGradient id="cgbeam" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFF1C4" stop-opacity=".55"></stop><stop offset="1" stop-color="#FFE7A8" stop-opacity=".08"></stop></linearGradient>
            <pattern id="cgsand" width="8" height="8" patternUnits="userSpaceOnUse"><rect width="8" height="8" fill="#E8D3A6"></rect><circle cx="2" cy="3" r=".8" fill="#C9A86A"></circle><circle cx="6" cy="6.5" r=".7" fill="#B8955A"></circle></pattern>
            <pattern id="cggrass" width="14" height="14" patternUnits="userSpaceOnUse"><rect width="14" height="14" fill="#A9C48A"></rect><path d="M2 12 l1.5 -5 M6 13 l.8 -6 M10 12 l-1 -5 M12 6 l1 -4 M4 5 l-1 -3" stroke="#6B8F4E" stroke-width=".9" opacity=".7"></path></pattern>
          </defs>
          <rect width="1200" height="820" fill="#F3ECDF"></rect>
          <g set:html={isoSvg}></g>
          <path d="" fill="none" stroke="#E8A33D" stroke-width="4" stroke-dasharray="8 8" class="flowpath" opacity="0" data-doorflow></path>
          {zones.map((z) => (
            <g class="zone" data-zone={z.id} tabindex="0" role="button" aria-label={z.n}>
              <polygon points={zonePoly(z)} fill="transparent"></polygon>
            </g>
          ))}
          {zones.map((z) => { const [lx, ly] = labelAt(z); return (
            <g class="zlabel" pointer-events="none" transform={`translate(${lx.toFixed(1)} ${ly.toFixed(1)})`}>
              <rect x="0" y="-11" width={z.n.length * 6.6 + 14} height="17" rx="8.5" fill="#FBF7EF" fill-opacity=".92" stroke="#23201A" stroke-opacity=".25"></rect>
              <text x="7" y="1" font-size="9.5" fill="#23201A" letter-spacing="1">{z.n.toUpperCase()}</text>
            </g>
          ); })}
          <text x="1180" y="806" font-size="10" fill="#776F62" text-anchor="end" letter-spacing="1.4">CUTAWAY · NOT TO SCALE · ORIGINAL ILLUSTRATION</text>
        </svg>
        <aside class="plan-card" aria-live="polite">
          <p class="label" data-who></p>
          <h3 class="h3" data-n></h3>
          <p class="small" data-t></p>
          <p class="plan-ev" data-e></p>
        </aside>
      </div>
      <figcaption class="cap">Original cutaway illustration; not an architectural drawing. Evidence summaries draw on the sources listed below.</figcaption>
    </figure>

    <div class="cg-head cg-gap">
      <p class="label">Figure 2 · The day</p>
      <h2 class="h2">Together on purpose, <span class="it clay">apart when it helps.</span></h2>
      <p class="body">Each group keeps its own routine. Shared moments are planned into the day, short and repeated, so neither naps nor medication rounds are disturbed. Tap a block.</p>
    </div>

    <figure class="day" id="cgday">
      <div class="day-grid" data-daygrid></div>
      <p class="day-read" data-dayread aria-live="polite">Tap a block to see what happens.</p>
      <figcaption class="cap">An illustrative weekday. Real schedules depend on ages, licensing rules and residents’ care needs.</figcaption>
    </figure>

    <div class="cg-head cg-gap">
      <p class="label">Figure 3 · The Strength Studio</p>
      <h2 class="h2">One movement, <span class="it clay">two programs, one game.</span></h2>
      <p class="body">Pick a movement pattern. Each one has a fall-prevention version for older adults, a strength-and-skill version for children, and a game they can play together.</p>
    </div>

    <figure class="gym" id="cggym">
      <div class="gym-tabs" role="tablist" data-gymtabs></div>
      <div class="gym-cols">
        <article class="gym-card g-old"><p class="label">Older adults · fall prevention</p><h3 class="h3" data-old-h></h3><p class="small" data-old-t></p></article>
        <article class="gym-card g-kid"><p class="label">Children · strength & skill</p><h3 class="h3" data-kid-h></h3><p class="small" data-kid-t></p></article>
        <article class="gym-card g-both"><p class="label">Together</p><h3 class="h3" data-both-h></h3><p class="small" data-both-t></p></article>
      </div>
      <figcaption class="cap">Ideas for program design, not medical advice. Older adults’ programs should be set and progressed by a physical therapist or trained instructor; children’s strength work should be supervised and age-appropriate. Based on the Cochrane review of exercise for preventing falls (2019), WHO activity guidelines (2020) and youth resistance-training position statements (NSCA 2009; International Consensus 2014).</figcaption>
    </figure>
  </div>
</section>

<script define:vars={{ zones, ISO, skylights }}>
  // ---------- Figure 1: plan ----------
  const plan = document.getElementById('cgplan');
  if (plan) {
    const card = { who: plan.querySelector('[data-who]'), n: plan.querySelector('[data-n]'), t: plan.querySelector('[data-t]'), e: plan.querySelector('[data-e]') };
    const show = (id) => {
      const z = zones.find((q) => q.id === id); if (!z) return;
      card.who.textContent = z.who; card.n.textContent = z.n; card.t.textContent = z.t; card.e.textContent = z.e;
      plan.querySelectorAll('.zone').forEach((g) => g.classList.toggle('on', g.dataset.zone === id));
      card.n.parentElement.style.setProperty('--zc', z.c);
    };
    plan.querySelectorAll('.zone').forEach((g) => {
      g.addEventListener('click', () => show(g.dataset.zone));
      g.addEventListener('keydown', (ev) => { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); show(g.dataset.zone); } });
    });
    show('hall');
    const isoP = (x, y, z = 0) => [ISO.OX + (x - y) * 0.866 * ISO.S, ISO.OY + (x + y) * 0.5 * ISO.S - z * ISO.S];
    const P = (a) => a.map((p) => p.map((v) => v.toFixed(1)).join(',')).join(' ');
    const btn = plan.querySelector('[data-door]'), panel = plan.querySelector('[data-doorpanel]'), flow = plan.querySelector('[data-doorflow]');
    const f0 = isoP(500, 400), f1 = isoP(500, 520);
    flow.setAttribute('d', `M${f0[0]} ${f0[1]} L${f1[0]} ${f1[1]}`);
    let open = false;
    btn.addEventListener('click', () => {
      open = !open;
      panel.classList.toggle('up', open);
      flow.setAttribute('opacity', open ? '1' : '0');
      btn.textContent = open ? 'Lower the garage door ↓' : 'Raise the garage door ↑';
      btn.setAttribute('aria-pressed', String(open));
      if (open) show('yard');
    });
    const sun = plan.querySelector('[data-sun]'), st = plan.querySelector('[data-sunt]'), beams = plan.querySelector('[data-beams]');
    const drawSun = () => {
      const h = Number(sun.value);
      const k = Math.max(0.05, Math.sin(((h - 6) / 13) * Math.PI));
      const dx = (h - 12.5) * -16, dy = 40 + (1 - k) * 50;
      let s = '';
      skylights.forEach((q) => {
        const top = [isoP(q.x0, q.y0, 112), isoP(q.x1, q.y0, 112), isoP(q.x1, q.y1, 112), isoP(q.x0, q.y1, 112)];
        const fl = [isoP(q.x0 + dx, q.y0 + dy), isoP(q.x1 + dx, q.y0 + dy), isoP(q.x1 + dx, Math.min(q.y1 + dy, 425)), isoP(q.x0 + dx, Math.min(q.y1 + dy, 425))];
        s += `<polygon points="${P([top[0], top[1], fl[1], fl[0]])}" fill="url(#cgbeam)" opacity="${(0.12 + 0.22 * k).toFixed(2)}"></polygon>`;
        s += `<polygon points="${P([top[3], top[2], fl[2], fl[3]])}" fill="url(#cgbeam)" opacity="${(0.08 + 0.14 * k).toFixed(2)}"></polygon>`;
        s += `<polygon points="${P(fl)}" fill="#FFF3C9" opacity="${(0.15 + 0.3 * k).toFixed(2)}"></polygon>`;
      });
      beams.innerHTML = s;
      const hh = Math.floor(h), mm = Math.round((h - hh) * 60);
      st.textContent = `${hh}:${String(mm).padStart(2, '0')}`;
    };
    sun.addEventListener('input', drawSun); drawSun();
  }

  // ---------- Figure 2: day ----------
  const day = document.getElementById('cgday');
  if (day) {
    const lanes = [
      { n: 'Children', c: '#E8A33D', b: [
        [7, 8.5, 'Arrival & free play', 'Families drop off; children start in the Nature Hall, climbing and digging.'],
        [8.5, 9.5, 'Morning circle', 'Classroom time by age group.'],
        [9.5, 10.5, 'Door up · outdoor yard', 'The garage door rises; the yard becomes the classroom.'],
        [11.25, 12.25, 'Lunch', 'Children eat in their rooms or at the Hearth.'],
        [12.5, 14.5, 'Nap & quiet', 'The building quiets; nap rooms are dark and calm.'],
        [15.75, 18, 'Play & pickup', 'Free play indoors or out until families arrive.'],
      ] },
      { n: 'Shared', c: '#6B8F4E', b: [
        [10.5, 11.25, 'Garden Lab together', 'Small mixed groups check towers, measure growth and harvest for lunch.'],
        [14.75, 15.75, 'Movement games, then story', 'Paired games in the Strength Studio (balance statues, stepping-stone rivers, ball circles), then a short story and song at the Hearth.'],
      ] },
      { n: 'Older adults', c: '#8E7BA8', b: [
        [7.5, 9, 'Breakfast & care', 'Medications and personal care on residents’ own schedules.'],
        [9.25, 10.25, 'Balance & strength class', 'Fall-prevention training led by a physical therapist or trained instructor.'],
        [11.5, 12.5, 'Lunch at the Hearth', 'Meals cooked with produce from the Garden Lab.'],
        [12.5, 14.5, 'Rest, visitors, clubs', 'Quiet time, clubs and family visits while the children nap.'],
        [16, 17.5, 'Garden walk & dinner prep', 'A loop of the outdoor path, watering beds, helping prep dinner.'],
      ] },
    ];
    const toX = (h) => ((h - 7) / 11) * 100;
    let html = '<div class="day-axis">' + Array.from({ length: 12 }, (_, i) => `<span style="left:${toX(7 + i)}%">${7 + i > 12 ? 7 + i - 12 : 7 + i}${7 + i >= 12 ? 'p' : 'a'}</span>`).join('') + '</div>';
    lanes.forEach((l) => {
      html += `<div class="day-lane"><span class="day-ln" style="color:${l.c}">${l.n}</span><div class="day-track">` +
        l.b.map(([a, b, t, d]) => `<button type="button" class="day-b" style="left:${toX(a)}%;width:${toX(b) - toX(a)}%;--bc:${l.c}" data-d="${d}" data-t="${t}" aria-label="${t}"><span>${t}</span></button>`).join('') + '</div></div>';
    });
    day.querySelector('[data-daygrid]').innerHTML = html;
    const read = day.querySelector('[data-dayread]');
    day.querySelectorAll('.day-b').forEach((b) => b.addEventListener('click', () => {
      day.querySelectorAll('.day-b').forEach((o) => o.classList.toggle('on', o === b));
      read.innerHTML = `<strong>${b.dataset.t}.</strong> ${b.dataset.d}`;
    }));
  }

  // ---------- Figure 3: gym ----------
  const gym = document.getElementById('cggym');
  if (gym) {
    const moves = [
      { n: 'Balance', o: ['Standing balance', 'Standing with feet heel-to-toe or on one leg, starting next to a rail and progressing to hands-free as confidence grows.'], k: ['Log beam', 'Walking a low log forwards, backwards and sideways, then carrying something while doing it.'], b: ['Statues', 'One partner holds a balance pose while the other counts; then they swap and invent harder poses.'] },
      { n: 'Sit to stand', o: ['Chair stands', 'Standing up from a chair and sitting down slowly, without using the arms if possible. The movement behind getting out of bed, off the toilet and out of a car.'], k: ['Frog squats', 'Deep bodyweight squats and frog jumps, building leg strength and landing control.'], b: ['Up-down story', 'An elder reads a story; everyone stands up each time a chosen word is read.'] },
      { n: 'Step-ups', o: ['Low step-ups', 'Stepping onto a low step with a rail nearby, building the strength and control used on stairs and curbs.'], k: ['Stump hops', 'Stepping and hopping across tree stumps and low boulders.'], b: ['Stepping-stone river', 'Together they cross a “river” of stepping stones laid out on the floor, the child leading the way.'] },
      { n: 'Carry', o: ['Garden carry', 'Walking with a light watering can or basket in one or both hands: real tasks that train grip, posture and walking.'], k: ['Log & sandbag carry', 'Carrying small logs or sandbags across the yard.'], b: ['Harvest relay', 'Children carry the harvest from the Garden Lab to the Hearth; elders sort, weigh and record it.'] },
      { n: 'Reach & turn', o: ['Reach and turn', 'Reaching forward and to the side, and turning to look behind, while standing safely: the moves that often lead to falls in daily life.'], k: ['Throw & catch', 'Throwing and catching balls and beanbags of different sizes and weights.'], b: ['Ball circle', 'Seated or standing, everyone passes and tosses a soft ball around a circle, calling names.'] },
      { n: 'Floor to stand', o: ['Getting down and up', 'Practising getting down to the floor and back up with support, so a fall is less frightening and less dangerous. Always supervised.'], k: ['Animal crawls', 'Bear crawls, crab walks and rolling.'], b: ['Floor puzzles', 'A big floor puzzle or game that both ages work on together, getting down and up between turns.'] },
    ];
    const tabs = gym.querySelector('[data-gymtabs]');
    tabs.innerHTML = moves.map((m, i) => `<button type="button" role="tab" data-mv="${i}">${m.n}</button>`).join('');
    const set = (i) => {
      const m = moves[i];
      gym.querySelector('[data-old-h]').textContent = m.o[0]; gym.querySelector('[data-old-t]').textContent = m.o[1];
      gym.querySelector('[data-kid-h]').textContent = m.k[0]; gym.querySelector('[data-kid-t]').textContent = m.k[1];
      gym.querySelector('[data-both-h]').textContent = m.b[0]; gym.querySelector('[data-both-t]').textContent = m.b[1];
      tabs.querySelectorAll('button').forEach((b, j) => b.setAttribute('aria-selected', String(j === i)));
    };
    tabs.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => set(Number(b.dataset.mv))));
    set(0);
  }
</script>

<style>
  .cg { background: #F3ECDF; border-block: 1px solid var(--line); }
  .cg-in { padding-block: 88px; display: flex; flex-direction: column; gap: 28px; }
  .cg-head { display: flex; flex-direction: column; gap: 14px; max-width: 780px; }
  .cg-gap { margin-top: 56px; }
  .plan, .day, .gym { margin: 0; background: #FBF7EF; border: 1px solid var(--line); border-radius: 20px; padding: clamp(16px, 3vw, 28px); display: flex; flex-direction: column; gap: 18px; }
  .plan-ctl { display: flex; flex-wrap: wrap; gap: 14px 24px; align-items: center; justify-content: space-between; }
  .door-btn, .gym-tabs :global(button) { border: 1px solid rgba(35,32,26,.25); background: var(--accent); border-color: var(--accent); border-radius: 999px; padding: 9px 16px; font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; color: var(--ink); }
  .door-btn[aria-pressed='true'] { background: var(--ink); color: var(--ground); border-color: var(--ink); }
  .sun-ctl { display: flex; align-items: center; gap: 12px; flex: 1 1 280px; max-width: 460px; }
  .sun-ctl input { flex: 1; accent-color: #E8A33D; }
  .sun-t { font-family: var(--mono); font-size: 13px; min-width: 44px; }
  .plan-body { display: grid; grid-template-columns: minmax(0, 2.4fr) minmax(240px, 1fr); gap: 18px; align-items: start; }
  .plan-body svg { width: 100%; height: auto; display: block; border-radius: 10px; border: 1px solid var(--line); }
  .plan :global(.zone) { cursor: pointer; outline: none; }
  .plan :global(.zone polygon) { transition: fill .2s; }
  .plan :global(.zone:hover polygon), .plan :global(.zone:focus-visible polygon) { fill: rgba(232,163,61,.10); }
  .plan :global(.zone.on polygon) { fill: rgba(232,163,61,.14); stroke: #E8A33D; stroke-width: 3; stroke-dasharray: 8 5; }
  .plan :global(.doorpanel) { transition: transform .8s cubic-bezier(.3,.7,.2,1), opacity .8s; }
  .plan :global(.doorpanel.up) { transform: translateY(-62px); opacity: .35; }
  .plan :global(.flowpath) { animation: cgflow 1.2s linear infinite; transition: opacity .4s; }
  @keyframes cgflow { to { stroke-dashoffset: -24; } }
  .plan-card { --zc: #E8A33D; background: #F3ECDF; border: 1px solid var(--line); border-top: 4px solid var(--zc); border-radius: 14px; padding: 20px; display: flex; flex-direction: column; gap: 10px; position: sticky; top: 24px; }
  .plan-card .h3 { margin: 0; }
  .plan-ev { margin: 0; padding-top: 10px; border-top: 1px dashed rgba(35,32,26,.2); font-family: var(--serif); font-style: italic; font-size: 17px; line-height: 1.45; color: var(--ink); }
  .day-grid { display: flex; flex-direction: column; gap: 10px; overflow-x: auto; }
  .day :global(.day-axis) { position: relative; height: 18px; margin-left: 110px; min-width: 640px; font-family: var(--mono); font-size: 10px; color: var(--muted-2); }
  .day :global(.day-axis span) { position: absolute; transform: translateX(-50%); }
  .day :global(.day-lane) { display: grid; grid-template-columns: 100px 1fr; gap: 10px; align-items: center; min-width: 750px; }
