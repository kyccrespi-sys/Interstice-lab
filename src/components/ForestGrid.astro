  .src { position: relative; display: grid; grid-template-columns: 18px 1fr; column-gap: 10px; row-gap: 2px; align-items: center; padding: 12px 14px; border: 1px solid var(--line); border-radius: 14px; cursor: pointer; background: #F1EEE7; transition: border-color .2s, background .2s; }
