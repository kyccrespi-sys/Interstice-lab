---
// Figures for 004 · The Forest Grid. All are original, illustrative models, not forecasts.
// Capacity factors: U.S. EIA, Electric Power Annual Table 4.08.B, 2025.
const sources = [
  { id: 'solar', n: 'Solar panels', c: '#C99242', cf: '24%', tree: 'Fast pioneer', weak: 'Night, clouds, winter' },
  { id: 'wind', n: 'Wind', c: '#3E7F8C', cf: '34%', tree: 'Tall canopy', weak: 'Calm spells, late summer' },
  { id: 'hydro', n: 'Hydro', c: '#5B7FA6', cf: '34%', tree: 'Riverside tree', weak: 'Drought' },
  { id: 'geo', n: 'Geothermal', c: '#8C4A2F', cf: '66%', tree: 'Deep taproot', weak: 'Only where the heat is' },
  { id: 'nuclear', n: 'Nuclear', c: '#6E5A8A', cf: '91%', tree: 'Old-growth giant', weak: 'Hot rivers, outages' },
  { id: 'csp', n: 'Solar thermal', c: '#C77B2B', cf: '24%', tree: 'Sun that stores heat', weak: 'Cloudy weeks' },
  { id: 'store', n: 'Batteries', c: '#6B8F4E', cf: 'Stores', tree: 'Fungal store', weak: 'Hours, not weeks' },
  { id: 'gas', n: 'Natural gas', c: '#7A7468', cf: 'On demand', tree: 'Fast invasive: fills any gap', weak: 'Carbon, fuel price swings' },
  { id: 'coal', n: 'Coal', c: '#3A3631', cf: 'Steady', tree: 'Ancient buried forest', weak: 'Most carbon, slow to ramp' },
];
---
<section class="fg gallery" aria-labelledby="fg-h">
  <div class="wrap fg-in">
    <div class="fg-head">
      <p class="label">Figure 1 · Grow the mix</p>
      <h2 class="h2" id="fg-h">A monoculture grid <span class="it clay">versus a mixed forest.</span></h2>
      <p class="body">Each energy source is a different species, with its own rhythm and its own weak spot, from sun and wind to nuclear, gas and coal. Pick which to plant. Every grid is sized to make the same total energy over two weeks; watch how often it falls short. Then send a heat wave through it.</p>
    </div>

    <figure class="mix" id="fgmix">
      <div class="mix-ctl">
        <div class="presets" role="group" aria-label="Presets">
          <button type="button" data-preset="solar">Monoculture · solar only</button>
          <button type="button" data-preset="nuclear">Monoculture · nuclear only</button>
          <button type="button" data-preset="gas">Monoculture · gas only</button>
          <button type="button" data-preset="solar,wind,store">Solar + wind + batteries</button>
          <button type="button" data-preset="gas,coal,nuclear,wind,solar,hydro">A typical grid today</button>
          <button type="button" data-preset="solar,wind,hydro,geo,nuclear,csp,store">Mixed forest · seven clean sources</button>
        </div>
        <div class="srcs" role="group" aria-label="Energy sources">
          {sources.map((s) => (
            <label class="src" style={`--c:${s.c}`}>
              <input type="checkbox" value={s.id} />
              <span class="src-dot"></span>
              <span class="src-n">{s.n} <em>{s.cf}</em></span>
              <span class="src-t">{s.tree} · weak spot: {s.weak}</span>
            </label>
          ))}
        </div>
        <div class="weather" role="group" aria-label="Weather">
          <span class="label muted">Weather</span>
          <button type="button" data-wx="normal" aria-pressed="true">Ordinary two weeks</button>
          <button type="button" data-wx="heat" aria-pressed="false">Heat wave + drought, days 6–10</button>
        </div>
      </div>
      <div class="mix-chart">
        <svg viewBox="0 0 900 300" role="img" aria-label="Two weeks of supply against demand" font-family="IBM Plex Mono, monospace">
          <rect width="900" height="300" fill="#FBFAF7"></rect>
          <g data-days></g>
          <rect x="0" y="34" width="0" height="246" fill="#8C4A2F" fill-opacity=".07" data-heatband></rect>
          <path d="" fill="#8C4A2F" fill-opacity=".22" data-short></path>
          <path d="" fill="none" stroke="#1F1D1A" stroke-width="1.4" stroke-dasharray="4 3" data-demand></path>
          <path d="" fill="none" stroke="#C99242" stroke-width="2.2" data-supply></path>
          <text x="20" y="22" font-size="10" fill="#1F1D1A" letter-spacing="1.4">— — DEMAND</text>
          <text x="130" y="22" font-size="10" fill="#7A5A2E" letter-spacing="1.4">━ SUPPLY</text>
          <text x="226" y="22" font-size="10" fill="#8C4A2F" letter-spacing="1.4">▇ SHORTFALL</text>
          <text x="880" y="22" font-size="10" fill="#8C4A2F" letter-spacing="1.4" text-anchor="end" data-heatlabel></text>
        </svg>
      </div>
      <div class="mix-out">
        <div><span class="mo-n" data-met>—</span><span class="mo-l">Hours fully powered</span></div>
        <div><span class="mo-n" data-gap>—</span><span class="mo-l">Longest shortfall</span></div>
        <div><span class="mo-n" data-kinds>—</span><span class="mo-l">Kinds of source</span></div>
        <div><span class="mo-n" data-co2>—</span><span class="mo-l">Lb of CO₂ per MWh</span></div>
      </div>
      <p class="mix-verdict" data-verdict aria-live="polite"></p>
      <figcaption class="cap">Illustrative model with made-up weather. Percentages are U.S. average capacity factors for 2025 (EIA): how much a source actually produces compared with running flat out all year. Gas and coal run when operators choose, so their output depends on fuel prices rather than weather. Carbon uses EIA averages for 2019: about 976 lb of CO₂ per MWh for gas and 2,257 for coal. Batteries store energy rather than make it. Imports and demand response are left out.</figcaption>
    </figure>

    <div class="fg-head fg-gap">
      <p class="label">Figure 2 · Follow the energy</p>
      <h2 class="h2">Every handoff <span class="it clay">pays a toll in heat.</span></h2>
      <p class="body">The second law of thermodynamics says no conversion is perfect. Follow 100 units of energy through a forest food chain and through a steam power plant, then put the waste heat to work.</p>
    </div>

    <figure class="cas" id="fgcas">
      <div class="cas-ctl"><button type="button" class="cas-btn" data-reuse aria-pressed="false">Put the waste heat to work</button></div>
      <svg viewBox="0 0 900 460" role="img" aria-label="Energy cascades through a food chain and a power plant" font-family="IBM Plex Mono, monospace">
        <rect width="900" height="460" fill="#F1EEE7"></rect>
        <text x="30" y="36" font-size="10.5" fill="#6B8F4E" letter-spacing="2">THE FOREST · ENERGY CAPTURED BY PLANTS = 100</text>
        <text x="30" y="258" font-size="10.5" fill="#7A5A2E" letter-spacing="2">THE POWER PLANT · HEAT FROM FUEL = 100</text>
        <g data-cas></g>
      </svg>
      <p class="cas-read" data-casread aria-live="polite"></p>
      <figcaption class="cap">Rounded figures. Food chains pass on roughly 10% per level on average (Lindeman, 1942), with wide variation. Steam-cycle plants, nuclear or fossil, turn about a third of their heat into electricity (EIA; World Nuclear Association). U.S. transmission and distribution losses averaged about 5% in 2018–2022 (EIA).</figcaption>
    </figure>

    <div class="fg-head fg-gap">
      <p class="label">Figure 3 · Weather the storm</p>
      <h2 class="h2">One trunk line, <span class="it clay">or a networked understory?</span></h2>
      <p class="body">Send a storm through each grid. In a hub-and-spoke grid, one broken line can darken everything downstream. In a networked grid, neighborhoods can cut loose, run on their own sources and share with each other.</p>
    </div>

    <figure class="net" id="fgnet">
      <div class="net-ctl">
        <div class="net-tabs" role="tablist">
          <button type="button" role="tab" data-net="hub" aria-selected="true">Hub and spoke</button>
          <button type="button" role="tab" data-net="mesh" aria-selected="false">Networked microgrids</button>
        </div>
        <button type="button" class="storm" data-storm>Send a storm ⚡</button>
      </div>
      <svg viewBox="0 0 900 420" role="img" aria-label="Grid network diagram" font-family="IBM Plex Mono, monospace">
        <rect width="900" height="420" fill="#F1EEE7"></rect>
        <g data-layer></g>
        <g class="bolt" data-bolt opacity="0"><path d="M0 -40 L-14 0 L0 0 L-10 36 L18 -8 L4 -8 L14 -40Z" fill="#C99242" stroke="#7A5A2E"></path></g>
      </svg>
      <p class="net-read" data-netread aria-live="polite">Press “Send a storm” to break the main line.</p>
      <figcaption class="cap">Schematic. Networked microgrids are being designed and tested today, for example in Adjuntas, Puerto Rico; this drawing is original and simplified.</figcaption>
    </figure>
  </div>
</section>

<script>
  // ---------- Figure 1: energy mix ----------
  const mix = document.getElementById('fgmix');
  if (mix) {
    const H = 14 * 24, HS = 5 * 24, HE = 10 * 24;
    let seed = 7; const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
    const cloud = Array.from({ length: 14 }, () => 0.15 + rnd() * 0.85);
    cloud[4] = 0.12; cloud[5] = 0.18; cloud[10] = 0.1;
    let w = 0.5; const windBase: number[] = [];
    for (let t = 0; t < H; t++) { w += (rnd() - 0.5) * 0.18 + (0.5 - w) * 0.02; if (t > 140 && t < 200) w -= 0.012; w = Math.max(0, Math.min(1.2, w)); windBase.push(w); }
    const mean = (a: number[]) => a.reduce((x, y) => x + y, 0) / a.length;
    const inHeat = (t: number) => t >= HS && t < HE;
    const build = (heat: boolean) => {
      const hw = (t: number) => heat && inHeat(t);
      const cl = (t: number) => (hw(t) ? 0.95 : cloud[Math.floor(t / 24)]);
      const demand = Array.from({ length: H }, (_, t) => { const h = t % 24; return 0.75 + 0.25 * Math.exp(-((h - 8) ** 2) / 6) + 0.4 * Math.exp(-((h - 19) ** 2) / 8) + (hw(t) ? 0.35 * Math.exp(-((h - 16) ** 2) / 10) : 0); });
      const solar = Array.from({ length: H }, (_, t) => { const h = t % 24; return Math.max(0, Math.sin(((h - 6) / 12) * Math.PI)) * cl(t); });
      const csp = Array.from({ length: H }, (_, t) => { const h = t % 24; return h >= 9 || h < 1 ? cl(t) * 0.64 : 0; });
      const wind = windBase.map((v, t) => (hw(t) ? v * 0.35 : v));
      const hydro = Array.from({ length: H }, (_, t) => (0.9 + 0.1 * Math.sin(t / 50)) * (hw(t) ? 0.5 : 1));
      const geo = Array.from({ length: H }, () => 1);
      const nuclear = Array.from({ length: H }, (_, t) => (hw(t) ? 0.6 : 1));
      const coal = Array.from({ length: H }, (_, t) => (hw(t) ? 0.85 : 1));
      return { demand, raw: { solar, csp, wind, hydro, geo, nuclear, coal } as Record<string, number[]> };
    };
    const normal = build(false), heatW = build(true);
    // size every source on the ordinary fortnight, so the heat wave is a true stress test
    const avgD = mean(normal.demand);
    const scale: Record<string, number> = {};
    Object.keys(normal.raw).forEach((k) => (scale[k] = 1 / mean(normal.raw[k])));

    const sim = (sel: string[], wx: typeof normal) => {
      const slots = sel.filter((s) => s !== 'store');
      const fixed = slots.filter((s) => s !== 'gas');
      const hasGas = sel.includes('gas');
      const supply = new Array(H).fill(0), coalOut = new Array(H).fill(0);
      fixed.forEach((g) => { const k = ((1.1 * avgD) / slots.length) * scale[g]; wx.raw[g].forEach((v, t) => { supply[t] += v * k; if (g === 'coal') coalOut[t] = v * k; }); });
      const gasCap = hasGas ? 1.6 * avgD * (slots.length === 1 ? 1 : 0.5) : 0; // gas is held as flexible reserve
      const delivered = new Array(H).fill(0);
      const cap = sel.includes('store') ? 10 * avgD : 0; let soc = cap * 0.5;
      let gasE = 0, coalE = 0, total = 0;
      for (let t = 0; t < H; t++) {
        let s = supply[t];
        if (cap) {
          if (s > wx.demand[t]) { soc = Math.min(cap, soc + (s - wx.demand[t]) * 0.9); s = wx.demand[t]; }
          else { const give = Math.min(wx.demand[t] - s, soc); soc -= give; s += give; }
        }
        if (hasGas && s < wx.demand[t]) { const g = Math.min(gasCap, wx.demand[t] - s); s += g; gasE += g; }
        delivered[t] = Math.min(s, wx.demand[t] * 1.6);
        const used = Math.min(delivered[t], wx.demand[t]); total += used;
        coalE += Math.min(coalOut[t], used);
      }
      const co2 = total ? Math.round((gasE * 976 + coalE * 2257) / total) : 0;
      return { delivered, co2 };
    };

    const X = (t: number) => 20 + (t / (H - 1)) * 860, Y = (v: number) => 280 - v * 125;
    mix.querySelector('[data-days]')!.innerHTML = Array.from({ length: 14 }, (_, d) => `<rect x="${X(d * 24)}" y="34" width="${860 / 14}" height="246" fill="${d % 2 ? '#F1EEE7' : '#FBFAF7'}"></rect><text x="${X(d * 24) + 4}" y="292" font-size="8" fill="#776F62">D${d + 1}</text>`).join('');
    const pathOf = (a: number[]) => 'M' + a.map((v, t) => `${X(t).toFixed(1)} ${Y(v).toFixed(1)}`).join(' L');
    let wxMode = 'normal';
    const boxes = Array.from(mix.querySelectorAll<HTMLInputElement>('.src input'));
    const q = (s: string) => mix.querySelector(s)!;
    const run = () => {
      const wx = wxMode === 'heat' ? heatW : normal;
      const sel = boxes.filter((b) => b.checked).map((b) => b.value);
      const gens = sel.filter((s) => s !== 'store');
      q('[data-demand]').setAttribute('d', pathOf(wx.demand));
      const band = q('[data-heatband]');
      band.setAttribute('x', String(X(HS))); band.setAttribute('width', wxMode === 'heat' ? String(X(HE) - X(HS)) : '0');
      q('[data-heatlabel]').textContent = wxMode === 'heat' ? 'HEAT WAVE + DROUGHT' : '';
      if (!gens.length) {
        q('[data-supply]').setAttribute('d', ''); q('[data-short]').setAttribute('d', '');
        q('[data-met]').textContent = '0%'; q('[data-gap]').textContent = '—'; q('[data-kinds]').textContent = String(sel.length); q('[data-co2]').textContent = '—';
        q('[data-verdict]').textContent = 'Plant at least one source that makes energy. Batteries only store it.';
        return;
      }
      const res = sim(sel, wx), del = res.delivered;
      q('[data-supply]').setAttribute('d', pathOf(del));
      let met = 0, run0 = 0, gap = 0;
      for (let t = 0; t < H; t++) { const short = del[t] < wx.demand[t] * 0.98; if (!short) met++; run0 = short ? run0 + 1 : 0; gap = Math.max(gap, run0); }
      q('[data-short]').setAttribute('d', 'M' + wx.demand.map((v, t) => `${X(t).toFixed(1)} ${Y(v).toFixed(1)}`).join(' L') + ' L' + del.map((v, t) => [t, Math.min(v, wx.demand[t])] as const).reverse().map(([t, v]) => `${X(t).toFixed(1)} ${Y(v).toFixed(1)}`).join(' L') + 'Z');
      const pct = Math.round((met / H) * 100);
      q('[data-met]').textContent = `${pct}%`;
      q('[data-gap]').textContent = gap ? `${gap} hrs` : 'None';
      q('[data-kinds]').textContent = String(sel.length);
      q('[data-co2]').textContent = res.co2 ? res.co2.toLocaleString() : '≈0';
      const only = sel.length === 1 ? sel[0] : '';
      let v: string;
      const fossil = sel.includes('gas') || sel.includes('coal');
      if (only === 'gas') v = `Gas fills every gap, which is why today’s grids lean on it. But it is a monoculture of a different kind: one fuel, one price, and about ${res.co2.toLocaleString()} lb of CO₂ for every megawatt-hour.`;
      else if (only === 'coal') v = `Coal runs steady but cannot follow the evening peak, and it is the most carbon-heavy species on the list: about ${res.co2.toLocaleString()} lb of CO₂ per megawatt-hour.`;
      else if (only === 'nuclear') v = wxMode === 'heat'
        ? 'The old-growth giant stumbles. Hot, low rivers force reactors to cut output just as air conditioners push demand up. A single species, however steady, shares one weak spot.'
        : 'Steady as old growth: a flat line around the clock. But it cannot follow the evening peak on its own, and every plant shares the same weak spots. Try the heat wave.';
      else if (pct >= 97 && fossil) v = 'Reliable, because gas or coal covers the gaps: when sun, wind or water dip, a fuel plant is turned up. It works, but the fossil species are doing the covering.';
      else if (pct >= 97 && !sel.includes('store')) v = 'Reliable: the steady species carry the load around the clock. Add storage or variable sources and see how the mix changes.';
      else if (pct >= 97) v = wxMode === 'heat'
        ? 'A mixed forest bends instead of breaking. Hydro and nuclear sag, but strong sun, solar thermal, geothermal and storage carry the load.'
        : 'A mixed forest: when one source dips, another is up, and storage carries the rest. Different kinds of source, failing at different times, did the work.';
      else if (pct >= 75) v = 'Better. Sources that peak at different times cover more of each other’s gaps, but long calm, cloudy or hot spells still get through.';
      else if (sel.length > 1) v = 'Some help: the sources cover a few of each other’s gaps. But with too little steady output or storage, their bad hours still line up.';
      else v = 'A monoculture: plenty of energy on average, but it all arrives and disappears at once. When its one weakness hits, the town goes dark.';
      if (fossil && only !== 'gas' && only !== 'coal') v += ` The fossil share costs about ${res.co2.toLocaleString()} lb of CO₂ per megawatt-hour delivered.`;
      q('[data-verdict]').textContent = v;
    };
    boxes.forEach((b) => b.addEventListener('change', () => { mix.querySelectorAll('[data-preset]').forEach((p) => p.setAttribute('aria-pressed', 'false')); run(); }));
    mix.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((p) => p.addEventListener('click', () => {
      const s = p.dataset.preset!.split(','); boxes.forEach((b) => (b.checked = s.includes(b.value)));
      mix.querySelectorAll('[data-preset]').forEach((o) => o.setAttribute('aria-pressed', String(o === p)));
      run();
    }));
    mix.querySelectorAll<HTMLButtonElement>('[data-wx]').forEach((b) => b.addEventListener('click', () => {
      wxMode = b.dataset.wx!; mix.querySelectorAll('[data-wx]').forEach((o) => o.setAttribute('aria-pressed', String(o === b))); run();
    }));
    (mix.querySelector('[data-preset="solar"]') as HTMLButtonElement).click();
  }

  // ---------- Figure 2: energy cascade ----------
  const cas = document.getElementById('fgcas');
  if (cas) {
    const g = cas.querySelector('[data-cas]')!, read = cas.querySelector('[data-casread]')!, btn = cas.querySelector<HTMLButtonElement>('[data-reuse]')!;
    let reuse = false;
    const bar = (x: number, y: number, v: number, col: string, label: string, sub: string) => {
      const h = Math.max(3, v * 1.1);
      return `<g><rect x="${x}" y="${y + 110 - h}" width="64" height="${h}" rx="3" fill="${col}"></rect>
        <text x="${x + 32}" y="${y + 104 - h}" font-size="13" fill="#1F1D1A" text-anchor="middle" font-family="Instrument Serif, serif" font-weight="600">${v}</text>
        <text x="${x + 32}" y="${y + 128}" font-size="9" fill="#1F1D1A" text-anchor="middle" letter-spacing="1">${label}</text>
        <text x="${x + 32}" y="${y + 141}" font-size="8" fill="#776F62" text-anchor="middle">${sub}</text></g>`;
    };
    const arrow = (x: number, y: number) => `<path d="M${x} ${y} L${x + 40} ${y}" stroke="#A8A397" stroke-width="1.4" marker-end="url(#casar)"></path>`;
    const heat = (x: number, y: number, v: number) => `<g><path d="M${x} ${y} q 6 -10 0 -20 q -6 -10 0 -20" fill="none" stroke="#8C4A2F" stroke-width="1.4" opacity=".75"></path><text x="${x + 8}" y="${y - 22}" font-size="9" fill="#8C4A2F">−${v} heat</text></g>`;
    const draw = () => {
      let s = `<defs><marker id="casar" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10z" fill="#A8A397"></path></marker></defs>`;
      const fy = 64;
      s += bar(40, fy, 100, '#6B8F4E', 'PLANTS', 'sunlight captured');
      s += arrow(118, fy + 90) + heat(150, fy + 70, 90);
      s += bar(200, fy, 10, '#9DB57F', 'PLANT-EATERS', '~10% passed on');
      s += arrow(278, fy + 90) + heat(310, fy + 70, 9);
      s += bar(360, fy, 1, '#C3D3AE', 'PREDATORS', '~10% of that');
      s += `<path d="M120 ${fy + 152} C 300 ${fy + 175} 520 ${fy + 175} 560 ${fy + 120}" fill="none" stroke="#6B8F4E" stroke-dasharray="4 4" stroke-width="1.4" class="cflow"></path>`;
      s += `<g transform="translate(520 ${fy + 40})"><rect width="330" height="78" rx="6" fill="#FBFAF7" stroke="#6B8F4E" stroke-opacity=".5"></rect>
        <text x="16" y="24" font-size="10" fill="#6B8F4E" letter-spacing="1.4">DECOMPOSERS</text>
        <text x="16" y="44" font-size="11" fill="#1F1D1A" font-family="Instrument Serif, serif">Fungi and microbes feed on what every level leaves:</text>
        <text x="16" y="62" font-size="11" fill="#1F1D1A" font-family="Instrument Serif, serif">fallen leaves, dead wood, waste. Nothing is thrown away.</text></g>`;
      const py = 286;
      s += bar(40, py, 100, '#7A5A2E', 'FUEL HEAT', 'nuclear or fossil');
      s += arrow(118, py + 90) + heat(150, py + 70, 67);
      s += bar(200, py, 33, '#C99242', 'ELECTRICITY', '~1/3 of the heat');
      s += arrow(278, py + 90) + heat(310, py + 70, 2);
      s += bar(360, py, 31, '#F0C27A', 'DELIVERED', '~5% lost on lines');
      if (reuse) {
        s += `<path d="M150 ${py + 40} C 300 ${py - 10} 500 ${py - 10} 560 ${py + 30}" fill="none" stroke="#8C4A2F" stroke-width="2" stroke-dasharray="6 5" class="cflow"></path>`;
        s += bar(560, py, 40, '#D9826B', 'HEAT REUSED', 'warms buildings');
        s += `<g transform="translate(650 ${py + 34})"><text font-size="11" fill="#1F1D1A" font-family="Instrument Serif, serif">Up to ~70 of 100 units</text><text y="18" font-size="11" fill="#1F1D1A" font-family="Instrument Serif, serif">put to use, instead of 31.</text><text y="40" font-size="9" fill="#776F62">Illustrative; depends on the plant</text><text y="53" font-size="9" fill="#776F62">and on nearby heat demand.</text></g>`;
      } else {
        s += `<g transform="translate(560 ${py + 44})"><text font-size="11" fill="#1F1D1A" font-family="Instrument Serif, serif">About two thirds of the heat leaves</text><text y="18" font-size="11" fill="#1F1D1A" font-family="Instrument Serif, serif">through cooling towers or into a river.</text></g>`;
      }
      g.innerHTML = s;
      read.textContent = reuse
        ? 'Like decomposers in a forest, combined heat and power and district heating feed on what the power plant throws away. Low-grade heat is useless for making electricity but perfect for warming homes and water.'
        : 'Both chains lose energy as heat at every step; that is the second law. The forest makes up for it by recycling everything. The power plant, as usually run, simply dumps two thirds of its heat.';
      btn.setAttribute('aria-pressed', String(reuse));
      btn.textContent = reuse ? 'Show the usual plant' : 'Put the waste heat to work';
    };
    btn.addEventListener('click', () => { reuse = !reuse; draw(); });
    draw();
  }

  // ---------- Figure 3: storm ----------
  const net = document.getElementById('fgnet');
  if (net) {
    const layer = net.querySelector('[data-layer]')!, bolt = net.querySelector<SVGGElement>('[data-bolt]')!, read = net.querySelector('[data-netread]')!;
    let mode = 'hub', stormed = false;
    const plant = { x: 120, y: 210 };
    const towns = [{ x: 470, y: 90 }, { x: 620, y: 70 }, { x: 760, y: 120 }, { x: 500, y: 330 }, { x: 650, y: 350 }, { x: 790, y: 300 }];
    const sub = { x: 360, y: 210 };
    const house = (x: number, y: number, on: boolean, src: boolean) => `
      <g transform="translate(${x} ${y})">
        <circle r="34" fill="${on ? '#C99242' : '#1F1D1A'}" fill-opacity="${on ? 0.18 : 0.08}"></circle>
        <path d="M-14 6 L-14 -6 L0 -18 L14 -6 L14 6Z" fill="${on ? '#FBFAF7' : '#CFCBC0'}" stroke="#1F1D1A"></path>
        <rect x="-4" y="-3" width="8" height="9" fill="${on ? '#C99242' : '#A8A397'}"></rect>
        ${src ? `<circle cx="20" cy="-16" r="7" fill="#C99242" stroke="#7A5A2E"></circle><rect x="-30" y="10" width="12" height="7" fill="#6B8F4E" stroke="#1F1D1A" stroke-width=".6"></rect>` : ''}
      </g>`;
    const line = (a: { x: number; y: number }, b: { x: number; y: number }, ok: boolean, cls = '') => `<path d="M${a.x} ${a.y} L${b.x} ${b.y}" stroke="${ok ? '#7A5A2E' : '#8C4A2F'}" stroke-width="2" ${ok ? 'stroke-dasharray="7 6" class="nf ' + cls + '"' : 'stroke-dasharray="2 6" opacity=".6"'}></path>`;
    const plantSvg = `<g transform="translate(${plant.x} ${plant.y})"><rect x="-34" y="-30" width="68" height="60" rx="4" fill="#FBFAF7" stroke="#1F1D1A"></rect><path d="M-16 -30 L-16 -52 L-6 -52 L-6 -30 M6 -30 L6 -46 L16 -46 L16 -30" fill="#CFCBC0" stroke="#1F1D1A"></path><text y="48" font-size="10" fill="#1F1D1A" text-anchor="middle" letter-spacing="1.4">BIG PLANT</text></g>`;
    const subSvg = `<g transform="translate(${sub.x} ${sub.y})"><rect x="-14" y="-14" width="28" height="28" fill="#FBFAF7" stroke="#1F1D1A"></rect><text y="32" font-size="9" fill="#776F62" text-anchor="middle" letter-spacing="1.2">SUBSTATION</text></g>`;
    const draw = () => {
      let s = '';
      if (mode === 'hub') {
        s += line(plant, sub, !stormed); towns.forEach((t) => (s += line(sub, t, !stormed)));
        s += plantSvg + subSvg; towns.forEach((t) => (s += house(t.x, t.y, !stormed, false)));
        if (stormed) s += `<text x="${(plant.x + sub.x) / 2}" y="${plant.y + 30}" font-size="11" fill="#8C4A2F" text-anchor="middle" letter-spacing="1.4">LINE DOWN</text>`;
      } else {
        const ring = [0, 1, 2, 5, 4, 3, 0];
        for (let i = 0; i < ring.length - 1; i++) s += line(towns[ring[i]], towns[ring[i + 1]], true, 'share');
        s += line(towns[0], towns[3], true, 'share'); s += line(towns[2], towns[5], true, 'share');
        s += line(plant, sub, !stormed); s += line(sub, towns[0], !stormed); s += line(sub, towns[3], !stormed);
        s += plantSvg + subSvg; towns.forEach((t) => (s += house(t.x, t.y, true, true)));
        s += `<text x="630" y="214" font-size="10" fill="#6B8F4E" text-anchor="middle" letter-spacing="1.4">NEIGHBORS SHARE</text>`;
        if (stormed) s += `<text x="${(plant.x + sub.x) / 2}" y="${plant.y + 30}" font-size="11" fill="#8C4A2F" text-anchor="middle" letter-spacing="1.4">LINE DOWN · ISLANDED</text>`;
      }
      layer.innerHTML = s;
      read.textContent = !stormed ? 'Press “Send a storm” to break the main line.'
        : mode === 'hub' ? 'Every neighborhood goes dark. One broken trunk line cuts off all six, like a forest of a single species hit by its one pest.'
        : 'The main line is down, but the neighborhoods island themselves, run on local solar and batteries, and trade power along the ring. The lights stay on.';
    };
    net.querySelectorAll<HTMLButtonElement>('[data-net]').forEach((b) => b.addEventListener('click', () => {
      mode = b.dataset.net!; stormed = false;
      net.querySelectorAll('[data-net]').forEach((o) => o.setAttribute('aria-selected', String(o === b)));
      net.querySelector('[data-storm]')!.textContent = 'Send a storm ⚡'; bolt.setAttribute('opacity', '0');
      draw();
    }));
    net.querySelector('[data-storm]')!.addEventListener('click', (e) => {
      stormed = !stormed;
      (e.currentTarget as HTMLElement).textContent = stormed ? 'Repair the line' : 'Send a storm ⚡';
      bolt.setAttribute('transform', `translate(${(plant.x + sub.x) / 2} ${plant.y - 60})`);
      bolt.setAttribute('opacity', stormed ? '1' : '0');
      draw();
    });
    draw();
  }
</script>

