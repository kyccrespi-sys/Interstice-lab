---
// Fig. 02 — the Viable Doughnut, built in four stages.
// The stage text lives in the `stages` list below; edit it freely.
const stages = [
  {
    label: 'Systems',
    formal: 'dS/dt = inflow − outflow',
    analysis: 'Start with one stock, the economy, fed by inflows and drained by outflows. A balancing loop (B) compares the stock to a goal and corrects the gap.',
    idea: 'Begin with one thing that accumulates, and the loop that keeps it in bounds.',
    src: 'Meadows 2008',
  },
  {
    label: 'Interconnectedness',
    formal: 'V(regulator) ≥ V(system)',
    analysis: 'Many interdependent actors regulate one another. Control is distributed across the network, and each regulator needs at least as much variety as what it regulates (Ashby’s Law).',
    idea: 'No part is self-sufficient. Stability is a property of the web.',
    src: 'Beer 1973 · Capra & Luisi 2014',
  },
  {
    label: 'Integration',
    formal: 'Economy ⊂ Society ⊂ Living world',
    analysis: 'Each level is a viable system nested inside a larger one. The boundaries between levels are drawn as dashed rings.',
    idea: 'The edges between levels are where the limits live.',
    src: 'Beer 1973 · Capra & Luisi 2014 · Raworth 2017',
  },
  {
    label: 'Social',
    formal: 'floor ≤ xᵢ ≤ ceiling',
    analysis: 'The nesting rings become the Doughnut: twelve dimensions of the social foundation inside, nine planetary boundaries outside. Each one is an essential variable to hold between the two, with balancing loops pushing back from both rings.',
    idea: 'A safe and just space: the economy as a homeostat for human dignity.',
    src: 'Raworth 2012, 2017 · Rockström et al. 2009',
  },
];
