  .fig-tab[aria-selected='true'] { background: var(--ink); color: var(--ground); border-color: var(--ink); }
  .fig-tab-num { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; opacity: 0.7; }
  .fig-tab-label { font-size: 17px; font-weight: 400; }
  .fig-text { display: flex; flex-direction: column; gap: 28px; }
  .fig-text[hidden] { display: none; }
  .fig-analytic { display: flex; flex-direction: column; gap: 10px; padding: 28px; border-radius: 24px; background: var(--ground); border: 1px solid var(--line); }
  .fig-formal { margin: 0; font-family: var(--mono); font-size: 16px; line-height: 1.6; color: var(--ink); }
  .fig-concept { display: flex; flex-direction: column; gap: 10px; padding: 0 4px; }
