<script>
  const root = document.getElementById('figure');
  if (root) {
    let stage = 4;
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-stage]');
    const texts = root.querySelectorAll<HTMLElement>('[data-text]');
    const layers = root.querySelectorAll<SVGGElement>('[data-layer]');
    const num = root.querySelector('[data-stage-num]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const show = (n: number) => {
      stage = n;
      tabs.forEach((t) => t.setAttribute('aria-selected', String(Number(t.dataset.stage) === n)));
      texts.forEach((t) => (t.hidden = Number(t.dataset.text) !== n));
      layers.forEach((g) => {
        const l = Number(g.dataset.layer);
        let o = l <= n ? 1 : 0.06;
        if (l === 3 && n > 3) o = 0.35;
        g.style.opacity = String(o);
      });
      if (num) num.textContent = String(n);
      if (next) next.textContent = n < 4 ? 'Next stage →' : 'Start over ↺';
    };
    let timer: number | undefined;
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };
    tabs.forEach((t) => t.addEventListener('click', () => { stop(); show(Number(t.dataset.stage)); }));
    next?.addEventListener('click', () => { stop(); show(stage < 4 ? stage + 1 : 1); });
    prev?.addEventListener('click', () => { stop(); show(stage > 1 ? stage - 1 : 4); });
    show(4);
    // When the figure first scrolls into view, build it up stage by stage.
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!calm) {
      const fig = root.querySelector('.fig-figure');
      const watcher = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          watcher.disconnect();
          show(1);
          timer = window.setInterval(() => { if (stage < 4) show(stage + 1); else stop(); }, 2600);
        }
      }, { threshold: 0.45 });
      if (fig) watcher.observe(fig);
    }
  }
</script>

