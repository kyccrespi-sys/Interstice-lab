---
// Timeline tree: sources in date order, alternating above and below one trunk that ends at the framework.
// Desktop: horizontal grid, evenly spaced by order. Mobile: vertical trunk.
interface Item { year: string; field: string; work: string; by: string }
interface Props { items: Item[]; title: string; endYear?: number }
const { items, title, endYear = 2026 } = Astro.props;
const yr = (s: string) => parseInt(s, 10) || endYear;
const sorted = items.map((it, i) => ({ ...it, n: yr(it.year), i })).sort((a, b) => a.n - b.n || a.i - b.i);
const n = sorted.length;
const field = (s: string) => s.replace(/\s*·\s*where it emerges/i, '');
---
<figure class="ltree" aria-label={`Timeline of ${n} sources that lead to ${title}`}>
  <ol class="lt-grid" style={`--n:${n}`}>
    {sorted.map((d, k) => (
      <li class={`lt-item ${k % 2 === 0 ? 'up' : 'down'}`} style={`--c:${k + 1};--d:${(k * 0.1).toFixed(2)}s`}>
        <div class="lt-card">
          <span class="lt-field">{field(d.field)}</span>
          <span class="lt-work">{d.work}</span>
          <span class="lt-by">{d.by}</span>
        </div>
        <span class="lt-stem" aria-hidden="true"></span>
        <span class="lt-node" aria-hidden="true"><span class="lt-year">{d.year}</span></span>
      </li>
    ))}
    <li class={`lt-end ${(n - 1) % 2 === 0 ? 'txt-down' : 'txt-up'}`} style={`--c:${n + 1}`}>
      <span class="lt-endnode" aria-hidden="true"></span>
      <span class="lt-endtxt"><span class="lt-field">Where the branches meet · {endYear}</span><span class="lt-endt">{title}</span></span>
    </li>
    <li class="lt-trunk" aria-hidden="true"></li>
  </ol>
  <figcaption class="lt-cap">Sources in date order, each joining one trunk that ends at the scenario. Spacing follows order, not exact years.</figcaption>
</figure>

<script>
  // Fade the branches in once the tree scrolls into view. Without JS, or if the observer never fires, everything stays visible.
  document.querySelectorAll<HTMLElement>('.ltree').forEach((el) => {
    if (!('IntersectionObserver' in window)) return;
    const r = el.getBoundingClientRect();
    if (r.top < window.innerHeight && r.bottom > 0) return; // already on screen: show immediately
    el.classList.add('wait');
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { el.classList.remove('wait'); io.disconnect(); } }, { rootMargin: '0px 0px -10% 0px' });
    io.observe(el);
    window.setTimeout(() => el.classList.remove('wait'), 8000);
  });
</script>

<style>
  .ltree { margin: 0; display: flex; flex-direction: column; gap: 14px; padding-top: 14px; }
  .lt-grid { list-style: none; margin: 0; padding: 0; position: relative; display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr)) minmax(0, 1.25fr);
    grid-template-rows: auto 56px auto; column-gap: 0; }
  .lt-item { grid-column: var(--c) / span 2; display: flex; flex-direction: column; position: relative; min-width: 0; }
  .lt-item.up { grid-row: 1; justify-content: flex-end; }
  .lt-item.down { grid-row: 3; flex-direction: column-reverse; justify-content: flex-end; }
  .lt-card { display: flex; flex-direction: column; gap: 3px; padding: 10px 14px 10px 14px; margin-right: 18px;
    background: var(--card, #FBFAF7); border-left: 2px solid var(--accent); max-width: 340px; }
  .lt-field { font-family: var(--mono); font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent-ink); }
  .lt-work { font-size: 15px; line-height: 1.3; color: var(--ink); }
  .lt-by { font-family: var(--serif); font-style: italic; font-size: 14.5px; line-height: 1.3; color: var(--muted); }
  /* stem from the card's edge down (or up) to the trunk */
  .lt-stem { display: block; width: 0; height: 28px; border-left: 1.4px solid var(--ink); }
  .lt-item.up .lt-stem { height: 28px; }
  /* node sits on the trunk: positioned into the middle row */
  .lt-node { position: absolute; left: -5px; width: 11px; height: 11px; border-radius: 50%; background: var(--ground); border: 1.5px solid var(--ink); z-index: 2; }
  .lt-item.up .lt-node { bottom: -33px; }
  .lt-item.down .lt-node { top: -33px; }
  .lt-year { position: absolute; left: 16px; font-family: var(--display); font-style: italic; font-size: 20px; line-height: 1; color: var(--clay); white-space: nowrap; }
  .lt-item.up .lt-year { top: 12px; }
  .lt-item.down .lt-year { bottom: 12px; }
  .lt-item.up .lt-stem { margin-bottom: -28px; }
  .lt-item.down .lt-stem { margin-top: -28px; }
  /* trunk */
  .lt-trunk { grid-row: 2; grid-column: 1 / -1; position: relative; }
  .lt-trunk::before { content: ''; position: absolute; left: 0; right: calc(100% * 1.25 / (var(--n) + 1.25)); top: 50%; height: 2.4px; background: var(--ink); transform: translateY(-50%); }
  .lt-end { grid-row: 2; grid-column: var(--c); position: relative; display: flex; align-items: center; z-index: 2; }
  .lt-endnode { flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--accent); border: 1.5px solid var(--ink); margin-left: -12px; position: relative; }
  .lt-endnode::after { content: ''; position: absolute; inset: -9px; border-radius: 50%; border: 1px dashed var(--accent); }
  .lt-endtxt { display: flex; flex-direction: column; gap: 2px; min-width: 0; position: absolute; left: -12px; right: 0; }
  .lt-end.txt-up .lt-endtxt { bottom: calc(50% + 26px); }
  .lt-end.txt-down .lt-endtxt { top: calc(50% + 26px); }
  .lt-endt { font-family: var(--display); font-size: 28px; line-height: 1.02; color: var(--ink); }
  .lt-cap { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; color: var(--muted-2); }
  @media (prefers-reduced-motion: no-preference) {
    .lt-endnode::after { animation: ltpulse 2.8s ease-out infinite; }
    .ltree.wait .lt-item { opacity: 0; transform: translateY(6px); }
    .lt-item { transition: opacity .6s ease, transform .6s ease; transition-delay: var(--d); }
  }
  @keyframes ltpulse { 0% { transform: scale(.7); opacity: .9; } 100% { transform: scale(1.4); opacity: 0; } }

  /* vertical layout on narrow screens */
  @media (max-width: 860px) {
    .lt-grid { display: flex; flex-direction: column; gap: 18px; padding-left: 30px; }
    .lt-trunk { position: absolute; left: 7px; top: 8px; bottom: 30px; width: 2.4px; background: var(--ink); }
    .lt-trunk::before { display: none; }
    .lt-item, .lt-item.down { flex-direction: column; justify-content: flex-start; padding-top: 26px; }
    .lt-stem { display: none; }
    .lt-card { margin-right: 0; max-width: none; }
    .lt-item.up .lt-node, .lt-item.down .lt-node { top: 5px; bottom: auto; left: -28px; }
    .lt-item.up .lt-year, .lt-item.down .lt-year { top: -6px; bottom: auto; left: 22px; font-size: 19px; }
    .lt-end { padding-top: 4px; }
    .lt-endnode { margin-left: -35px; }
    .lt-end .lt-endtxt, .lt-end.txt-up .lt-endtxt, .lt-end.txt-down .lt-endtxt { position: static; padding-left: 14px; }
  }
</style>
