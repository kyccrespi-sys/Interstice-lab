---
// The anatomy of a Kahn-style scenario, after Kahn & Wiener, "The Use of Scenarios" (1967). Original illustration.
const steps = [
  { k: '1', t: 'Start from the present', d: 'Begin with a reasonable picture of where things stand today, and of how the real decision-makers are likely to behave.', x: 110, y: 220 },
  { k: '2', t: 'Find the branching points', d: 'Mark the moments where a choice, an accident or a shock could send events one way or another.', x: 380, y: 220 },
  { k: '3', t: 'Let the forces interact', d: 'Follow how political, military, economic, social and psychological pressures push on each other at the same time, including the choices of individual leaders.', x: 630, y: 130 },
  { k: '4', t: 'Write several endings', d: 'Tell more than one plausible story, and do not stop at the most probable one. History often delivers what looked implausible beforehand.', x: 730, y: 220 },
];
const ends = [
  { y: 60, l: 'Future A' }, { y: 140, l: 'Future B' }, { y: 220, l: 'Surprise-free' }, { y: 300, l: 'Future C' }, { y: 380, l: 'Wild card' },
];
---
<figure class="tree" id="stree" aria-label="How a Kahn-style scenario is built, in four steps">
  <div class="tree-stage">
    <svg viewBox="0 0 1000 440" role="img" aria-label="A branching diagram from the present to several possible futures" font-family="IBM Plex Mono, monospace">
      <rect width="1000" height="440" fill="#F1EEE7"></rect>
      <path d="M110 220 L380 220" stroke="#1F1D1A" stroke-width="2.4"></path>
      <path d="M380 220 C 470 220 480 100 560 100 L 820 60" fill="none" stroke="#C99242" stroke-width="2" class="tr-b"></path>
      <path d="M380 220 C 470 220 480 160 560 160 L 820 140" fill="none" stroke="#C99242" stroke-width="2" class="tr-b"></path>
      <path d="M380 220 L 820 220" fill="none" stroke="#1F1D1A" stroke-width="2" stroke-dasharray="6 5"></path>
      <path d="M380 220 C 470 220 480 290 560 290 L 820 300" fill="none" stroke="#3E7F8C" stroke-width="2" class="tr-b"></path>
      <path d="M560 290 C 640 290 680 380 820 380" fill="none" stroke="#8C4A2F" stroke-width="2" class="tr-b"></path>
      {ends.map((e) => <g><circle cx="830" cy={e.y} r="5" fill="#FBFAF7" stroke="#1F1D1A"></circle><text x="844" y={e.y + 4} font-size="11" fill="#1F1D1A" letter-spacing="1.2">{e.l.toUpperCase()}</text></g>)}
      <text x="110" y="250" font-size="11" fill="#1F1D1A" letter-spacing="1.6" text-anchor="middle">TODAY</text>
      {steps.map((s, i) => (
        <g class="tr-hot" data-step={i} tabindex="0" role="button" aria-label={`Step ${s.k}: ${s.t}`}>
          <circle cx={s.x} cy={s.y} r="22" fill="#FBFAF7" stroke="#7A5A2E" stroke-width="2"></circle>
          <circle cx={s.x} cy={s.y} r="22" fill="none" stroke="#C99242" stroke-width="2" class="tr-pulse"></circle>
          <text x={s.x} y={s.y + 5} font-size="15" fill="#7A5A2E" text-anchor="middle" font-family="Instrument Serif, serif" font-weight="600">{s.k}</text>
        </g>
      ))}
    </svg>
  </div>
  <div class="tree-card" aria-live="polite">
    <p class="label" data-k>Step 1 of 4</p>
    <h3 class="h3" data-t>{steps[0].t}</h3>
    <p class="small" data-d>{steps[0].d}</p>
    <div class="tree-nav">{steps.map((s, i) => <button type="button" data-go={i} aria-label={`Step ${s.k}`}>{s.k}</button>)}</div>
  </div>
  <figcaption class="tree-cap">Steps paraphrased from Herman Kahn and Anthony J. Wiener, “The Use of Scenarios,” adapted from <em>The Year 2000</em> (1967). Illustration is original.</figcaption>
</figure>

<script define:vars={{ steps }}>
  const root = document.getElementById('stree');
  if (root) {
    const k = root.querySelector('[data-k]'), t = root.querySelector('[data-t]'), d = root.querySelector('[data-d]');
    const hots = root.querySelectorAll('.tr-hot'), btns = root.querySelectorAll('[data-go]');
    const go = (i) => {
      k.textContent = `Step ${i + 1} of 4`; t.textContent = steps[i].t; d.textContent = steps[i].d;
      hots.forEach((h, j) => h.classList.toggle('on', j === i));
      btns.forEach((b, j) => b.setAttribute('aria-current', j === i ? 'true' : 'false'));
    };
    hots.forEach((h, i) => { h.addEventListener('click', () => go(i)); h.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(i); } }); });
    btns.forEach((b, i) => b.addEventListener('click', () => go(i)));
    go(0);
  }
</script>

<style>
  .tree { margin: 8px 0 0; display: flex; flex-direction: column; gap: 12px; }
  .tree-stage { border: 1px solid rgba(31,29,26,.14); border-radius: 6px; overflow: hidden; background: #F1EEE7; }
  .tree-stage svg { width: 100%; height: auto; display: block; }
  .tree :global(.tr-hot) { cursor: pointer; outline: none; }
  .tree :global(.tr-hot.on circle:first-child) { fill: #C99242; }
  .tree :global(.tr-hot.on text) { fill: #FBFAF7; }
  .tree :global(.tr-hot:focus-visible circle:first-child) { stroke: #1F1D1A; stroke-width: 3; }
  .tree :global(.tr-pulse) { transform-box: fill-box; transform-origin: center; animation: trpulse 2.4s ease-out infinite; }
  .tree :global(.tr-b) { stroke-dasharray: 600; stroke-dashoffset: 600; animation: trdraw 2.2s ease forwards; }
  @keyframes trpulse { 0% { transform: scale(1); opacity: .8; } 100% { transform: scale(1.8); opacity: 0; } }
  @keyframes trdraw { to { stroke-dashoffset: 0; } }
  .tree-card { background: #FBFAF7; border: 1px solid rgba(31,29,26,.14); border-left: 4px solid #C99242; border-radius: 6px; padding: 20px 24px; display: flex; flex-direction: column; gap: 8px; }
  .tree-card .h3 { margin: 0; }
  .tree-nav { display: flex; gap: 8px; margin-top: 6px; }
  .tree-nav button { width: 34px; height: 34px; border-radius: 50%; border: 1px solid rgba(31,29,26,.3); background: transparent; cursor: pointer; font-family: var(--mono); color: var(--ink); }
  .tree-nav button[aria-current='true'] { background: var(--ink); color: var(--ground); }
  .tree-cap { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; color: var(--muted-2); line-height: 1.6; }
  @media (prefers-reduced-motion: reduce) { .tree :global(.tr-pulse) { animation: none; opacity: 0; } .tree :global(.tr-b) { animation: none; stroke-dashoffset: 0; } }
</style>
