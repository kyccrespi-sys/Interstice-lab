---
// Where they trained: three zoom levels — Colorado → the Camp Hale valley → the camp.
// Positions on levels 2 and 3 are schematic, reconstructed from published descriptions.
const BG = '#1C1D1B', FG = '#E8E4DA', HON = '#C99242', COOL = '#8FC1CB', WARM = '#D9826B', DIM = '#A8A397';

// Level 1 projection: Colorado is a lat/long rectangle (37–41°N, 102.05–109.05°W).
const X0 = 110, Y0 = 50, W = 780, H = 520;
const px = (lon: number) => X0 + ((lon + 109.05) / 7) * W;
const py = (lat: number) => Y0 + ((41 - lat) / 4) * H;
const divide = [[41, -106.86], [40.5, -106.7], [40.25, -105.8], [39.9, -105.75], [39.6, -105.95], [39.4, -106.18], [39.1, -106.45], [38.7, -106.3], [38.3, -106.35], [37.9, -106.9], [37.5, -106.95], [37.0, -106.5]];
const divideD = 'M' + divide.map(([la, lo]) => `${px(lo).toFixed(1)} ${py(la).toFixed(1)}`).join(' L');
const places = [
  { n: 'Denver', lat: 39.74, lon: -104.99, a: 'start' },
  { n: 'Camp Carson', lat: 38.74, lon: -104.79, a: 'start' },
  { n: 'Leadville', lat: 39.25, lon: -106.29, a: 'start' },
  { n: 'Vail', lat: 39.64, lon: -106.37, a: 'end' },
  { n: 'Aspen', lat: 39.19, lon: -106.82, a: 'end' },
  { n: 'Arapahoe Basin', lat: 39.64, lon: -105.87, a: 'start' },
];
const hale = { x: px(-106.31), y: py(39.42) };

// Level 2: schematic valley, north up. Valley runs roughly north–south.
const ridges = Array.from({ length: 9 }, (_, i) => i);
import { buildCamp } from './camp3d';
import { buildColorado, buildValley, haleCO } from './hmLevels';
const colorado = buildColorado();
const valley = buildValley();
const camp = buildCamp();
---
<figure id="halemap" class="hm" aria-label="Map: Colorado, the Camp Hale valley and the camp">
  <nav class="hm-scales" aria-label="Zoom level">
    <button type="button" data-go="1" aria-pressed="true"><span>1 : 3,000,000</span>Colorado</button>
    <button type="button" data-go="2" aria-pressed="false"><span>Schematic</span>The valley</button>
    <button type="button" data-go="3" aria-pressed="false"><span>Schematic</span>The camp</button>
  </nav>
  <div class="hm-stage">
    <!-- LEVEL 1 · COLORADO -->
    <svg viewBox="0 0 1000 625" class="hm-lvl on" data-level="1" data-origin={`${(haleCO[0] / 10).toFixed(1)}% ${(haleCO[1] / 6.25).toFixed(1)}%`} role="img" aria-label="Map of Colorado: Camp Hale sits on the Continental Divide in the Rocky Mountains near Leadville, about 75 miles west of Denver" font-family="IBM Plex Mono, monospace">
      <rect width="1000" height="625" fill={BG}></rect>
      <g set:html={colorado}></g>
    </svg>

    <!-- LEVEL 2 · THE VALLEY (schematic) -->
    <svg viewBox="0 0 1000 625" class="hm-lvl" data-level="2" role="img" aria-label="Map of the valley: Camp Hale in Eagle Park along the north-flowing Eagle River and the railroad, Pando at the north end, Tennessee Pass and Cooper Hill to the south, Homestake Peak to the southwest, and the D-Series maneuver area in the high country east toward Resolution Mountain" font-family="IBM Plex Mono, monospace">
      <rect width="1000" height="625" fill={BG}></rect>
      <g set:html={valley}></g>
    </svg>

    <!-- LEVEL 3 · THE CAMP (illustrative) -->
    <svg viewBox="0 0 1000 625" class="hm-lvl" data-level="3" role="img" aria-label="Illustrative axonometric of Camp Hale in winter: barracks, hospital, HQ, field house and stables, a coal train on the siding, skiers on the slope above camp, climbers on the cliffs, mule trains and falling snow" font-family="IBM Plex Mono, monospace">
      <rect width="1000" height="625" fill={BG}></rect>
      <g set:html={camp}></g>
      <text x="960" y="30" font-size="10" fill={FG} fill-opacity="0.7" text-anchor="end" letter-spacing="2">CAMP HALE · WINTER 1943–44</text>
      <text x="40" y="610" font-size="8" fill={DIM} letter-spacing="1.5">ILLUSTRATIVE AXONOMETRIC · RECONSTRUCTED FROM DESCRIPTIONS, NOT A SURVEY PLAN</text>
    </svg>

    <p class="hm-cap" data-cap>Colorado · Camp Hale</p>
  </div>
  <div class="hm-text">
    <div data-text="1">
      <p class="label">Level 1 · Colorado</p>
      <p class="small">The Army chose a valley floor at 9,200 feet near Leadville, high on the Continental Divide. A railroad already stopped at the Pando siding, and the Tennessee Pass area reliably got heavy snow.</p>
    </div>
    <div data-text="2" hidden>
      <p class="label">Level 2 · The valley</p>
      <p class="small">North is up. The camp filled Eagle Park, a flat meadow on the Eagle River, with the railroad running alongside and the village of Pando at its north end. Troops built their own ski area, Cooper Hill, with what was then the world's longest T-bar. In 1944 the whole division marched out for weeks of subzero mock battles between Tennessee Pass and Resolution Mountain.</p>
    </div>
    <div data-text="3" hidden>
      <p class="label">Level 3 · The camp</p>
      <p class="small">Stand on the parade ground in winter. Builders flattened about three miles of valley and channeled the river into a straight ditch. More than a thousand buildings went up: barracks, a hospital, stables, a field house. Skiers train on the slope above camp, climbers work the cliffs, mule strings carry loads down the camp road, and coal trains and furnaces fill the air with smoke: the cough it caused got a name, the Pando Hack.</p>
    </div>
    <button type="button" class="btn btn-ink hm-zoom" data-zoom>Zoom in ⊕</button>
  </div>
</figure>

<script>
  const root = document.getElementById('halemap');
  if (root) {
    const lv = Array.from(root.querySelectorAll<SVGSVGElement>('.hm-lvl'));
    const tx = Array.from(root.querySelectorAll<HTMLElement>('[data-text]'));
    const bt = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-go]'));
    const zoom = root.querySelector<HTMLButtonElement>('[data-zoom]')!;
    const cap = root.querySelector<HTMLElement>('[data-cap]')!;
    const caps = ['Colorado · Camp Hale', 'The valley · Eagle Park', 'The camp · illustrative'];
    const origins = ['50% 50%', '57% 40%', '50% 60%'];
    let cur = 1;
    const go = (n: number) => {
      if (n === cur) return;
      const inward = n > cur;
      const from = lv[cur - 1], to = lv[n - 1];
      from.style.transformOrigin = inward ? origins[cur] ?? '50% 50%' : '50% 50%';
      if (cur === 1 && inward) from.style.transformOrigin = from.dataset.origin || '50% 52%';
      from.classList.remove('on'); from.classList.add(inward ? 'out-in' : 'out-out');
      to.classList.remove('out-in', 'out-out'); to.classList.add(inward ? 'from-small' : 'from-big');
      requestAnimationFrame(() => requestAnimationFrame(() => { to.classList.remove('from-small', 'from-big'); to.classList.add('on'); }));
      cur = n;
      tx.forEach((t) => (t.hidden = Number(t.dataset.text) !== n));
      bt.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.go) === n)));
      cap.textContent = caps[n - 1];
      zoom.textContent = n < 3 ? 'Zoom in ⊕' : 'Back out ⊖';
    };
    bt.forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.go))));
    zoom.addEventListener('click', () => go(cur < 3 ? cur + 1 : 1));
  }
</script>

<style>
  .hm { margin: 0; display: flex; flex-direction: column; gap: 16px; }
  .hm-scales { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .hm-scales button { min-height: 56px; border-radius: 14px; border: 1px solid rgba(31,29,26,0.2); background: var(--card); color: var(--ink); font-family: var(--sans); font-size: 16px; cursor: pointer; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: 8px 14px; text-align: left; }
  .hm-scales button span { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; opacity: .7; }
  .hm-scales button[aria-pressed='true'] { background: var(--ink); color: var(--ground); border-color: var(--ink); }
  .hm-stage { position: relative; aspect-ratio: 1000 / 625; border-radius: 6px; overflow: hidden; background: #1C1D1B; box-shadow: 0 30px 80px -40px rgba(18,17,14,.7); }
  .hm-lvl { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity .7s ease, transform .9s cubic-bezier(.2,.7,.2,1); }
  .hm-lvl.on { opacity: 1; transform: scale(1); }
  .hm-lvl.out-in { opacity: 0; transform: scale(3); }
  .hm-lvl.out-out { opacity: 0; transform: scale(.35); }
  .hm-lvl.from-small { opacity: 0; transform: scale(.35); transition: none; }
  .hm-lvl.from-big { opacity: 0; transform: scale(3); transition: none; }
  .hm-cap { position: absolute; left: 18px; top: 14px; margin: 0; font-family: var(--mono); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: #C99242; }
  .hm-stage :global(.hm-target) { animation: hmglow 3s ease-in-out infinite; }
  .hm-stage :global(.flow) { animation: hmflow 1.6s linear infinite; }
  .hm-stage :global(.flow-rev) { animation: hmflowrev 3s linear infinite; }
  @keyframes hmflowrev { to { stroke-dashoffset: 40; } }
  .hm-stage :global(.flow-slow) { stroke-dasharray: 10 8; animation: hmflow 4s linear infinite; }
  .hm-stage :global(.smoke) { stroke-dasharray: 3 5; animation: hmflow 3s linear infinite; }
  .hm-stage :global(.haze) { animation: hmglow 6s ease-in-out infinite; }
  @keyframes hmglow { 50% { opacity: .5; } }
  @keyframes hmflow { to { stroke-dashoffset: -24; } }
  .hm-stage :global(.c3-smoke) { stroke-dasharray: 60; animation: c3smoke 5s linear infinite; animation-delay: var(--d, 0s); }
  @keyframes c3smoke { 0% { stroke-dashoffset: 60; opacity: 0; } 20% { opacity: .8; } 100% { stroke-dashoffset: -60; opacity: 0; } }
  .hm-stage :global(.c3-snow) { animation: c3snow var(--t, 8s) linear infinite; animation-delay: calc(var(--d, 0s) * -1); }
  @keyframes c3snow { from { transform: translate(0, -40px); } to { transform: translate(-20px, 640px); } }
  .hm-stage :global(.c3-flow) { animation: c3flow 3s linear infinite; }
  @keyframes c3flow { to { stroke-dashoffset: -30; } }
  .hm-stage :global(.c3-flag) { transform-box: fill-box; transform-origin: left center; animation: c3flag 1.6s ease-in-out infinite alternate; }
  @keyframes c3flag { to { transform: scaleX(.75) skewY(4deg); } }
  @media (prefers-reduced-motion: reduce) { .hm-lvl { transform: none !important; transition: opacity .3s ease; } .hm-stage :global(*) { animation: none !important; } }
  .hm-text { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .hm-text > div { flex: 1 1 380px; display: flex; flex-direction: column; gap: 8px; }
  .hm-text > div[hidden] { display: none; }
</style>
