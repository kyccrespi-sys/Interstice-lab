---
// Decade-by-decade timeline: who rose, the dominant mode of leadership, the research, the medium.
import { leaders, styles } from '../../data/leaders';
const decades = [
  { d: '1920s–30s', from: 1920, to: 1939, head: 'Crisis and the mass audience', text: 'Depression and the rise of dictators reward leaders who can reassure millions at once. Radio puts a leader’s voice in the living room.', research: '1939: Kurt Lewin compares autocratic, democratic and hands-off group leaders. Democratic groups do best.', medium: 'Radio' },
  { d: '1940s', from: 1940, to: 1949, head: 'Command at total-war scale', text: 'War rewards decisive command, but the winners are also coalition managers. Marshall and Eisenhower lead by organizing, not by speeches.', research: 'Military and industrial management spread “command and control” across postwar organizations.', medium: 'Radio, newsreels' },
  { d: '1950s', from: 1950, to: 1959, head: 'Organization men and moral movements', text: 'Big corporations prize hierarchy and loyalty. At the same time King and the civil rights movement show the power of leadership without formal authority.', research: 'Ohio State and Michigan studies split leadership into two dimensions: structure (task) and consideration (people).', medium: 'Television arrives' },
  { d: '1960s', from: 1960, to: 1969, head: 'Founders and outsiders', text: 'Walton and Graham build or remake companies from outside the establishment. Leaders start to be judged on television.', research: '1960: Douglas McGregor’s “Theory X and Theory Y” argues people work best when trusted.', medium: 'Television; long sound bites (43 seconds in 1968)' },
  { d: '1970s', from: 1970, to: 1979, head: 'Purpose and service', text: 'Morita, Hesselbein and Maathai lead through mission and shared ownership. Trust in institutions falls after Vietnam and Watergate.', research: 'Robert Greenleaf’s servant leadership (1970) and James MacGregor Burns’s transformational leadership (1978).', medium: 'Television; sound bites shrink' },
  { d: '1980s', from: 1980, to: 1989, head: 'Conviction and the celebrity CEO', text: 'Thatcher, Reagan and Welch lead with conviction and big personalities. Forced ranking and shareholder value take hold, while Kelleher bets on employees first.', research: '1987: Kouzes and Posner begin tracking what people admire in leaders; “honest” tops the list from the start.', medium: 'Cable TV; 9-second sound bites by 1988' },
  { d: '1990s', from: 1990, to: 1999, head: 'Reconciliation and reinvention', text: 'Mandela shows the power of reaching across divides. Jobs and Bezos make vision and speed the founder’s creed in the tech boom.', research: 'Emotional intelligence enters management (Goleman, 1995).', medium: 'The internet; email' },
  { d: '2000s', from: 2000, to: 2009, head: 'Humility and evidence', text: 'Corporate scandals and the 2008 crisis tarnish celebrity leaders. Merkel and Nooyi lead with patience, analysis and purpose.', research: 'Collins’s Level 5 (2001), Goleman’s six styles (2000), the GLOBE study (2004) and Google’s Project Oxygen (2008).', medium: 'Blogs, early social media' },
  { d: '2010s', from: 2010, to: 2019, head: 'Coaching, empathy, adaptability', text: 'Barra, Nadella and Ardern lead with accountability, a learning culture and empathy. Microsoft (2013) and GE (2015) drop forced ranking.', research: 'Growth mindset and psychological safety become mainstream management ideas.', medium: 'Social media and livestreams' },
  { d: '2020s', from: 2020, to: 2029, head: 'Leading through shocks', text: 'The pandemic and AI reward leaders who communicate clearly under uncertainty and adapt fast. Remote work tests leaders who relied on presence.', research: 'Gallup reports managers drive at least 70% of the variation in team engagement, which remains low.', medium: 'Video calls, short-form video' },
];
const rose = (a: number, b: number) => leaders.filter((l) => l.year >= a && l.year <= b).sort((x, y) => x.year - y.year);
---
<ol class="dt">
  {decades.map((d) => {
    const who = rose(d.from, d.to);
    return (
      <li class="dt-i">
        <div class="dt-d"><span>{d.d}</span></div>
        <div class="dt-c">
          <h3 class="dt-h">{d.head}</h3>
          <p class="dt-t">{d.text}</p>
          {who.length > 0 && (
            <div class="dt-who">
              {who.map((l) => <a href={`#p-${l.id}`} data-jump={l.id} class="dt-p"><b>{l.short}</b><span>{styles[l.style].label}</span></a>)}
            </div>
          )}
          <dl class="dt-dl">
            <dt>Research</dt><dd>{d.research}</dd>
            <dt>Medium</dt><dd>{d.medium}</dd>
          </dl>
        </div>
      </li>
    );
  })}
</ol>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.dt [data-jump]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); window.dispatchEvent(new CustomEvent('leader-jump', { detail: a.dataset.jump })); }));
</script>

<style>
  .dt { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .dt-i { display: grid; grid-template-columns: 120px 1fr; gap: 24px; }
  .dt-d { position: relative; border-right: 1px solid var(--line); padding-top: 4px; }
  .dt-d span { font-family: var(--mono); font-size: 13px; letter-spacing: .08em; color: var(--accent-ink); }
  .dt-d::after { content: ''; position: absolute; right: -6px; top: 8px; width: 11px; height: 11px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px var(--ground); }
  .dt-c { padding-bottom: 32px; display: flex; flex-direction: column; gap: 10px; }
  .dt-h { margin: 0; font-family: var(--display); font-weight: 400; font-size: 27px; line-height: 1.15; color: var(--ink); }
  .dt-t { margin: 0; font-size: 16.5px; line-height: 1.6; color: var(--ink-2); max-width: 720px; }
  .dt-who { display: flex; flex-wrap: wrap; gap: 8px; }
  .dt-p { display: flex; flex-direction: column; text-decoration: none; padding: 6px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--card); }
  .dt-p:hover { border-color: var(--accent); }
  .dt-p b { font-weight: 500; font-size: 14.5px; color: var(--ink); }
  .dt-p span { font-family: var(--mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--clay); }
  .dt-dl { margin: 0; display: grid; grid-template-columns: 84px 1fr; gap: 4px 12px; font-size: 14.5px; line-height: 1.5; }
  .dt-dl dt { font-family: var(--mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted-2); padding-top: 3px; }
  .dt-dl dd { margin: 0; color: var(--muted); }
  @media (max-width: 640px) {
    .dt-i { grid-template-columns: 1fr; gap: 6px; }
    .dt-d { border-right: 0; border-bottom: 1px solid var(--line); padding-bottom: 6px; }
    .dt-d::after { display: none; }
    .dt-c { padding-bottom: 26px; }
  }
</style>
