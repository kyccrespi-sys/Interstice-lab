---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Subscribe from '../../components/Subscribe.astro';
import { toRoman } from '../../data/inline';

const all = (await getCollection('frameworks')).sort((a, b) => a.data.course - b.data.course);
---
<Base title="Frameworks" description="Every framework published by Interstice Lab.">
  <section class="wrap head">
    <p class="label">All frameworks</p>
    <h1 class="h1">The <span class="it honey">frameworks</span></h1>
    <p class="lede">Each one draws on several fields, names every source, and ends with where it could be put to work.</p>
  </section>
  <section class="wrap grid-wrap">
    <div class="grid">
      <a class="card item primer-tile" href="/frameworks/systems-thinking/">
        <svg class="pt-art" viewBox="0 0 200 70" aria-hidden="true">
          <path d="M20 35 L70 35" stroke="#8FC1CB" stroke-width="1.4" stroke-dasharray="4 4"></path>
          <rect x="72" y="18" width="46" height="34" rx="3" fill="none" stroke="#E8E4DA" stroke-width="1.2"></rect>
          <rect x="73" y="34" width="44" height="17" fill="#C99242" opacity=".7"></rect>
          <path d="M120 35 L178 35" stroke="#D08A66" stroke-width="1.4" stroke-dasharray="4 4"></path>
          <path d="M95 54 C95 68 45 68 45 40" fill="none" stroke="#D9A55A" stroke-width="1" stroke-dasharray="2 3"></path>
          <circle cx="70" cy="62" r="6" fill="none" stroke="#D9A55A"></circle>
          <text x="70" y="65" font-size="7" fill="#D9A55A" text-anchor="middle" font-family="IBM Plex Mono, monospace">B</text>
        </svg>
        <p class="label">Start here · A primer</p>
        <h2 class="h3">What is systems thinking?</h2>
        <p class="small">The idea under every framework: stocks, flows, feedback loops and leverage points, with an interactive loop demo. About five minutes.</p>
        <span class="link-arrow">Read the primer →</span>
      </a>
      {all.map((f) => {
        const live = f.data.status === 'published';
        return (
          <article class="card item">
            <p class="label muted">Scenario {String(f.data.course).padStart(2, '0')} · {live ? f.data.category : 'Forthcoming'}</p>
            <h2 class="h3">{live ? <a href={`/frameworks/${f.id}/`}>{f.data.title} {f.data.titleAccent}</a> : <>{f.data.title} {f.data.titleAccent}</>}</h2>
            <p class="small">{f.data.summary}</p>
            <div class="chips">{f.data.fields.map((x) => <span class="chip">{x}</span>)}</div>
          </article>
        );
      })}
    </div>
  </section>
  <Subscribe />
</Base>

<style>
  .head { padding-block: 96px 56px; display: flex; flex-direction: column; gap: 24px; }
  .grid-wrap { padding-bottom: 104px; }
  .primer-tile { background: var(--gallery); border-color: var(--gallery); color: #E8E4DA; text-decoration: none; }
  .primer-tile:hover { color: #E8E4DA; }
  .primer-tile .label { color: #D9A55A; }
  .primer-tile .h3 { color: #E8E4DA; font-family: var(--display); font-weight: 400; font-size: 28px; line-height: 1.1; }
  .primer-tile .small { color: #B4AFA3; }
  .primer-tile .link-arrow { color: #D9A55A; margin-top: auto; }
  .pt-art { width: 100%; height: auto; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
  .item { padding: 32px; display: flex; flex-direction: column; gap: 14px; }
  .item a { color: var(--ink); text-decoration: none; }
  .item a:hover { color: var(--accent-ink); }
</style>
