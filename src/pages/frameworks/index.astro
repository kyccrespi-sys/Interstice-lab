---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Subscribe from '../../components/Subscribe.astro';
import SystemsPrimer from '../../components/SystemsPrimer.astro';
import { toRoman } from '../../data/inline';

const all = (await getCollection('frameworks')).sort((a, b) => a.data.course - b.data.course);
---
<Base title="Frameworks" description="Every framework published by Interstice Lab.">
  <section class="wrap head">
    <p class="label">All frameworks</p>
    <h1 class="h1">The <span class="it honey">frameworks</span></h1>
    <p class="lede">Each one draws on several fields, names every source, and ends with where it could be put to work.</p>
    <a class="st-cue" href="#systems-thinking"><span class="st-dot" aria-hidden="true"></span><span><strong>New to systems thinking?</strong> The idea under every framework, explained in five minutes.</span><span class="st-go">Start here ↓</span></a>
  </section>
  <section class="wrap grid-wrap">
    <div class="grid">
      {all.map((f) => {
        const live = f.data.status === 'published';
        return (
          <article class="card item">
            <p class="label muted">{f.data.number} · Course {toRoman(f.data.course)} · {live ? f.data.category : 'Forthcoming'}</p>
            <h2 class="h3">{live ? <a href={`/frameworks/${f.id}/`}>{f.data.title} {f.data.titleAccent}</a> : <>{f.data.title} {f.data.titleAccent}</>}</h2>
            <p class="small">{f.data.summary}</p>
            <div class="chips">{f.data.fields.map((x) => <span class="chip">{x}</span>)}</div>
          </article>
        );
      })}
    </div>
  </section>
  <section class="wrap primer-wrap"><SystemsPrimer /></section>
  <Subscribe />
</Base>

<style>
  .head { padding-block: 96px 56px; display: flex; flex-direction: column; gap: 24px; }
  .grid-wrap { padding-bottom: 72px; }
  .primer-wrap { padding-bottom: 104px; scroll-margin-top: 24px; }
  .st-cue { align-self: flex-start; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; padding: 14px 20px; border-radius: 999px; background: #EFEBE3; border: 1px solid var(--line); text-decoration: none; color: var(--ink); font-size: 15px; transition: transform .2s, box-shadow .2s; }
  .st-cue:hover { color: var(--ink); transform: translateY(-1px); box-shadow: 0 12px 26px -16px rgba(42,53,39,.5); }
  .st-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 6px rgba(201,146,66,.2); }
  .st-go { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--accent-ink); }
  @media (max-width: 640px) { .st-cue { border-radius: 18px; } }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
  .item { padding: 32px; display: flex; flex-direction: column; gap: 14px; }
  .item a { color: var(--ink); text-decoration: none; }
  .item a:hover { color: var(--accent-ink); }
</style>
