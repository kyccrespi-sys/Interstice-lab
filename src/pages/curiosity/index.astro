---
import Base from '../../layouts/Base.astro';
import Subscribe from '../../components/Subscribe.astro';

const stories = [
  {
    href: '/curiosity/10th-mountain-division/',
    no: '01',
    kicker: 'History · Mountains · Innovation',
    title: 'The Ski Troopers of Camp Hale',
    dek: 'The 10th Mountain Division trained at 9,200 feet, broke a German line with a night climb in the Italian Apennines, and came home to build the American ski industry.',
    tabs: ['Why', 'What', 'Who', 'How', 'Where', 'Inventors'],
    art: 'hale',
  },
  {
    href: '/curiosity/herman-kahn/',
    no: '02',
    kicker: 'History · Strategy · Foresight',
    title: 'Herman Kahn and the Invention of the Scenario',
    dek: 'A Burma telephone lineman turned bomb physicist and Cold War strategist, who taught governments and companies to plan for more than one future.',
    tabs: ['Why', 'Life', 'The Bomb', 'Strategy', 'Scenarios', 'Futures', 'Legacy'],
    art: 'kahn',
  },
  {
    href: '/curiosity/how-leaders-talk/',
    no: '03',
    kicker: 'Leadership · Communication · Data',
    title: 'How Leaders Talk',
    dek: 'Fourteen leaders across a century, from Roosevelt’s radio to Ardern’s live stream, read for how they decided and how they spoke, and what really changed.',
    tabs: ['Why', 'Leaders', 'The Map', 'The Data', 'Changed?', 'Borrow'],
    art: 'leaders',
  },
];
---
<Base title="Curiosity Corner" description="Stories from the edges of history, science and the outdoors.">
  <section class="wrap cc-head">
    <p class="label">Curiosity Corner</p>
    <h1 class="h1">Stories we couldn't <span class="it honey">stop reading about.</span></h1>
    <p class="lede">Away from the season's frameworks: deep dives into the people, places and ideas that sit just off the map, told with maps, timelines and the details that make them real.</p>
  </section>

  <section class="wrap cc-list">
    {stories.map((s) => (
      <a href={s.href} class="feat">
        <div class="feat-art" aria-hidden="true">
{s.art === 'leaders' ? (
          <svg viewBox="0 0 600 380" preserveAspectRatio="xMidYMid slice">
            <rect width="600" height="380" fill="#F1EEE7"></rect>
            {Array.from({ length: 6 }, (_, i) => <circle cx="120" cy="190" r={30 + i * 34} fill="none" stroke="#C99242" stroke-opacity={0.55 - i * 0.07} stroke-width="1.1"></circle>)}
            <circle cx="120" cy="190" r="9" fill="#8C4A2F"></circle>
            {Array.from({ length: 22 }, (_, i) => { const a = (i * 137.5) % 360 * Math.PI / 180, r = 40 + (i * 23) % 120; return <g><line x1="470" y1="190" x2={470 + r * Math.cos(a)} y2={190 + r * Math.sin(a) * 0.8} stroke="#1F1D1A" stroke-opacity=".25"></line><circle cx={470 + r * Math.cos(a)} cy={190 + r * Math.sin(a) * 0.8} r="4" fill="#FBFAF7" stroke="#1F1D1A" stroke-opacity=".7"></circle></g>; })}
            <circle cx="470" cy="190" r="7" fill="#C99242"></circle>
            <path d="M200 190 C 280 150 340 230 420 190" fill="none" stroke="#8C4A2F" stroke-dasharray="4 4"></path>
            <text x="24" y="356" font-family="IBM Plex Mono, monospace" font-size="11" fill="#7A5A2E" letter-spacing="2">BROADCAST → NETWORK · 1933–2023</text>
          </svg>
          ) : s.art === 'kahn' ? (
          <svg viewBox="0 0 600 380" preserveAspectRatio="xMidYMid slice">
            <rect width="600" height="380" fill="#F1EEE7"></rect>
            {Array.from({ length: 12 }, (_, i) => <path d={`M60 190 C 200 190 260 ${190 + (i - 5.5) * 8} 340 ${190 + (i - 5.5) * 22} S 520 ${190 + (i - 5.5) * 30} 580 ${190 + (i - 5.5) * 30}`} fill="none" stroke={i === 5 || i === 6 ? '#1F1D1A' : '#C99242'} stroke-opacity={i === 5 || i === 6 ? 0.8 : 0.35 + (i % 3) * 0.15} stroke-width={i === 5 || i === 6 ? 1.6 : 1.1}></path>)}
            <circle cx="60" cy="190" r="10" fill="#8C4A2F"></circle>
            {[300, 350, 400].map((x) => <circle cx={x} cy="190" r="4" fill="#FBFAF7" stroke="#7A5A2E"></circle>)}
            <text x="24" y="356" font-family="IBM Plex Mono, monospace" font-size="11" fill="#7A5A2E" letter-spacing="2">RAND · HUDSON · 1947–1983</text>
          </svg>
          ) : (
          <svg viewBox="0 0 600 380" preserveAspectRatio="xMidYMid slice">
            <rect width="600" height="380" fill="#1C1D1B"></rect>
            {Array.from({ length: 16 }, (_, r) => {
              const base = 120 + r * 16;
              let d = '';
              for (let x = 0; x <= 600; x += 10) {
                const h = 90 * Math.exp(-(((x - 180 - r * 4) / 80) ** 2)) + 120 * Math.exp(-(((x - 420 + r * 3) / 70) ** 2)) + 10 * Math.sin(x / 17 + r);
                d += `${x === 0 ? 'M' : 'L'}${x} ${(base - h * (0.4 + r * 0.03)).toFixed(1)} `;
              }
              return <g><path d={d + `L600 400 L0 400Z`} fill="#1C1D1B"></path><path d={d} fill="none" stroke="#E8E4DA" stroke-opacity={0.2 + r * 0.035} stroke-width="0.8"></path></g>;
            })}
            <circle cx="420" cy="70" r="16" fill="#C99242"></circle>
            <text x="24" y="356" font-family="IBM Plex Mono, monospace" font-size="11" fill="#C99242" letter-spacing="2">CAMP HALE · 9,200 FT · 1942–1945</text>
          </svg>
          )}
        </div>
        <div class="feat-body">
          <p class="label">No. {s.no} · {s.kicker}</p>
          <h2 class="h2">{s.title}</h2>
          <p class="small">{s.dek}</p>
          <div class="chips">{s.tabs.map((t) => <span class="chip">{t}</span>)}</div>
          <span class="link-arrow">Read the story →</span>
        </div>
      </a>
    ))}
    <p class="label muted more">More stories coming</p>
  </section>
  <Subscribe />
</Base>

<style>
  .cc-head { padding-block: 96px 56px; display: flex; flex-direction: column; gap: 24px; }
  .cc-list { padding-bottom: 104px; display: flex; flex-direction: column; gap: 24px; }
  .feat { display: flex; flex-wrap: wrap; border-radius: 28px; overflow: hidden; background: var(--card); border: 1px solid var(--line); text-decoration: none; color: var(--ink); box-shadow: 0 24px 60px -30px rgba(28,29,27,0.35); }
  .feat:hover { color: var(--ink); }
  .feat-art { flex: 1 1 460px; min-height: 300px; }
  .feat-art svg { width: 100%; height: 100%; display: block; }
  .feat-body { flex: 1 1 380px; padding: 44px; display: flex; flex-direction: column; gap: 18px; }
  .feat-body .link-arrow { color: var(--accent-ink); }
  .more { text-align: center; padding-top: 16px; }
  @media (max-width: 640px) { .feat-body { padding: 28px; } }
</style>
