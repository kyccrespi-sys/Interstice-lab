---
import Base from '../../layouts/Base.astro';
import ResearchPanel from '../../components/leaders/ResearchPanel.astro';
import TraitCards from '../../components/leaders/TraitCards.astro';
import TraitMatrix from '../../components/leaders/TraitMatrix.astro';
import LeaderTable from '../../components/leaders/LeaderTable.astro';
import DecadeTimeline from '../../components/leaders/DecadeTimeline.astro';
import TrendCharts from '../../components/leaders/TrendCharts.astro';
import Subscribe from '../../components/Subscribe.astro';
import { leaders, styles, traits, periods } from '../../data/leaders';

const tabs = [
  { id: 'findings', label: 'Key Findings', sub: 'The short version' },
  { id: 'research', label: 'The Research', sub: 'Big studies' },
  { id: 'traits', label: 'Traits', sub: '12 summaries' },
  { id: 'leaders', label: 'Leaders', sub: '29 profiles' },
  { id: 'time', label: 'Over Time', sub: 'Decade by decade' },
  { id: 'verdict', label: 'Verdict', sub: 'What it adds up to' },
];
const N = leaders.length;
const P = (y: number) => periods.findIndex((p) => y >= p.from && y <= p.to);
const pn = periods.map((_, i) => leaders.filter((l) => P(l.year) === i).length);
const has = (id: string) => leaders.filter((l) => l.traits.includes(id as any)).length;
const core = ['resolve', 'comm', 'vision'];
const coreK = leaders.map((l) => core.filter((c) => l.traits.includes(c as any)).length);
const two = coreK.filter((k) => k >= 2).length, all3 = coreK.filter((k) => k === 3).length;
const adaptPct = periods.map((_, i) => Math.round((100 * leaders.filter((l) => P(l.year) === i && l.traits.includes('adapt')).length) / pn[i]));
const styleIds = Object.keys(styles) as (keyof typeof styles)[];
const styleRows = styleIds.map((s) => ({ s, c: periods.map((_, i) => leaders.filter((l) => P(l.year) === i && (l.style === s || l.style2 === s)).map((l) => l.short)) }));
const nonUS = leaders.filter((l) => !l.region.startsWith('United States')).length;
const women = leaders.filter((l) => ['thatcher', 'graham', 'hesselbein', 'maathai', 'oprah', 'merkel', 'nooyi', 'barra', 'ardern'].includes(l.id)).length;
---
<Base title="What Great Leaders Share" description="Curiosity Corner: what the big leadership studies say, tested against 29 of the most successful leaders of the last hundred years. Styles, core traits, successes, shortcomings and what changed.">
  <section class="hero">
    <div class="wrap hero-in">
      <p class="label">Curiosity Corner · No. 03</p>
      <h1 class="t-title">What Great Leaders Share <span class="it">The research, tested against 29 leaders, 1930–2023</span></h1>
      <p class="t-dek">Four of the largest studies of leadership, from a 62-country survey of managers to decades of polling on what followers admire. Then 29 of the century’s most successful leaders, from Gandhi to Nadella, profiled one by one: their style, their defining traits, their wins and their failures.</p>
      <div class="stats">
        <div><span class="n">29</span><span class="l">Leaders across 5 fields and 9 countries</span></div>
        <div><span class="n">62</span><span class="l">Societies in the GLOBE study</span></div>
        <div><span class="n">0</span><span class="l">Traits shared by all 29</span></div>
        <div><span class="n">{two}</span><span class="l">Have 2 or more of the core 3: resolve, communication, vision</span></div>
      </div>
    </div>
  </section>

  <div class="wrap art">
    <nav class="rail" aria-label="Article sections">
      <p class="label muted rail-head">In this story</p>
      {tabs.map((t, i) => (
        <a href={`#${t.id}`} class="rail-tab" data-tab={t.id} aria-current={i === 0 ? 'true' : undefined}>
          <span class="rail-n">0{i + 1}</span>
          <span class="rail-l">{t.label}</span>
          <span class="rail-s">{t.sub}</span>
        </a>
      ))}
    </nav>

    <div class="panels">
      <!-- FINDINGS -->
      <section class="panel" id="findings" data-panel="findings">
        <p class="label">01 · Key Findings</p>
        <h2 class="h2">Six things the evidence <span class="it clay">agrees on.</span></h2>
        <p class="body">We read the major studies first, then checked them against 29 leaders whose success is hard to dispute on its own terms: results at very large scale, results that lasted, and recognition from critics as well as admirers. Here is what holds up.</p>
        <div class="kf">
          <article class="card"><span class="kf-n">01</span><h3 class="h3">Followers want the same four things everywhere</h3><p class="small">Honest, forward-looking, competent, inspiring. These have topped Kouzes and Posner’s surveys since 1987, and honesty, foresight and inspiration are among the 22 attributes GLOBE found valued in every one of 62 societies.</p><p class="ev">Kouzes &amp; Posner 1987–2012 · GLOBE 2004</p></article>
          <article class="card"><span class="kf-n">02</span><h3 class="h3">Three traits form a near-universal core</h3><p class="small">Among our 29: resolve in {has('resolve')}, inspiring communication in {has('comm')}, vision in {has('vision')}. Every leader has at least one, {two} have two or more, {all3} have all three. No single trait appears in all 29.</p><p class="ev">Our profiles · <a href="#traits" data-goto="traits">see Traits</a></p></article>
          <article class="card"><span class="kf-n">03</span><h3 class="h3">Personality predicts who gets picked, more than who succeeds</h3><p class="small">Extraversion is the strongest personality link to leadership (r = .31), but it predicts who emerges as a leader better than who leads well. Several of our most effective leaders, Marshall, Eisenhower, Merkel, Buffett, were not charismatic speakers.</p><p class="ev">Judge et al. 2002 · <a href="#research" data-goto="research">see Research</a></p></article>
          <article class="card"><span class="kf-n">04</span><h3 class="h3">Most of leadership depends on culture</h3><p class="small">GLOBE found more culturally contingent attributes (35) than universal ones (30). Risk-taking, a mark of Gandhi, Morita and Bezos, is prized in some societies and distrusted in others. The universal list is about trust, foresight and teamwork, not personality.</p><p class="ev">GLOBE 2004</p></article>
          <article class="card"><span class="kf-n">05</span><h3 class="h3">Styles shifted; the core did not</h3><p class="small">Commanding and hands-off delegative styles appear among leaders who rose before 1990 and not after. Adaptability rose from {adaptPct[0]}% of the earliest leaders to {adaptPct[2]}% of those who rose after 1990. Resolve, communication and vision stayed roughly level.</p><p class="ev">Our profiles · Goleman 2000 · <a href="#time" data-goto="time">see Over Time</a></p></article>
          <article class="card"><span class="kf-n">06</span><h3 class="h3">The biggest failures were strengths overused</h3><p class="small">Thatcher’s resolve became the poll tax; Reagan’s delegation allowed Iran-Contra; Welch’s standards became forced ranking. Most of the rest were blind spots outside the main mission, such as Mandela on HIV/AIDS.</p><p class="ev">Our profiles · <a href="#leaders" data-goto="leaders">see Leaders</a></p></article>
        </div>
        <h3 class="h3 gap-top">How we did this</h3>
        <div class="method">
          <div><b>Who</b><span>29 leaders across politics, the military and science, business, movements, media and sport; {women} are women and {nonUS} led outside the U.S.</span></div>
          <div><b>Styles</b><span>Nine styles from Goleman (2000), Lewin (1939), Greenleaf (1970) and Burns (1978). Each leader gets a main style and, where it fits, a second.</span></div>
          <div><b>Traits</b><span>Twelve traits, each tied to a research finding. A trait is marked only when the record shows it clearly.</span></div>
          <div><b>Limits</b><span>Marks are our judgment, not measured scores. Honesty, the top research trait, is not marked: it is too contested to judge from the record.</span></div>
        </div>
      </section>

      <!-- RESEARCH -->
      <section class="panel" id="research" data-panel="research" hidden>
        <p class="label">02 · The Research</p>
        <h2 class="h2">What a century of studies <span class="it clay">actually found.</span></h2>
        <p class="body">Leadership research tends to ask one of three questions: what followers want, what kind of person becomes a leader, and which behaviors get results. The biggest studies on each give a consistent picture, with important caveats.</p>
        <ResearchPanel />
      </section>

      <!-- TRAITS -->
      <section class="panel" id="traits" data-panel="traits" hidden>
        <p class="label">03 · Traits</p>
        <h2 class="h2">Twelve traits, <span class="it clay">and the shadow each one casts.</span></h2>
        <p class="body">Each card gives what the trait is, the research behind it, how many of the 29 show it, who shows it best, how it changed over time and what it looks like overused. Sorted from most to least common.</p>
        <TraitCards />
        <h3 class="h3 gap-top">The full grid</h3>
        <p class="body">All 29 leaders by all 12 traits. Read across a row for one leader, or down a column for one trait.</p>
        <TraitMatrix />
      </section>

      <!-- LEADERS -->
      <section class="panel" id="leaders" data-panel="leaders" hidden>
        <p class="label">04 · Leaders</p>
        <h2 class="h2">Twenty-nine leaders, <span class="it clay">compared and profiled.</span></h2>
        <p class="body">Filter by field, era, style or trait, and sort by any column. Open a row for the full profile: defining characteristics with the evidence, the signature decision, successes and shortcomings.</p>
        <LeaderTable />
      </section>

      <!-- TIME -->
      <section class="panel" id="time" data-panel="time" hidden>
        <p class="label">05 · Over Time</p>
        <h2 class="h2">The traits held. <span class="it clay">The styles changed.</span></h2>
        <p class="body">Group the 29 by when they rose, and count every main or second style. Commanding and delegative styles disappear after 1990; visionary leadership is constant; democratic, affiliative and coaching styles spread.</p>
        <div class="ss" role="table" aria-label="Leadership styles by period">
          <div class="ss-r ss-h" role="row"><span role="columnheader">Style</span>{periods.map((p, i) => <span role="columnheader">Rose {p.label} <em>({pn[i]})</em></span>)}</div>
          {styleRows.map((r) => (
            <div class="ss-r" role="row">
              <span role="rowheader" class="ss-s">{styles[r.s].label}</span>
              {r.c.map((names) => (
                <span role="cell" class="ss-c">
                  <span class="ss-dots">{names.map(() => <i></i>)}</span>
                  <span class="ss-n">{names.length ? names.join(', ') : '—'}</span>
                </span>
              ))}
            </div>
          ))}
        </div>
        <h3 class="h3 gap-top">Decade by decade</h3>
        <DecadeTimeline />
        <h3 class="h3 gap-top">How leaders talk changed too</h3>
        <p class="body">Communication moved from formal and distant toward plain and close. Two long-running measures from American politics:</p>
        <TrendCharts />
      </section>

      <!-- VERDICT -->
      <section class="panel" id="verdict" data-panel="verdict" hidden>
        <p class="label">06 · Verdict</p>
        <h2 class="h2">What it <span class="it clay">adds up to.</span></h2>
        <div class="qa">
          <div><p class="q">Do great leaders share the same traits?</p><p class="a">A small core, yes. Resolve, communication and vision appear in most of the 29, and followers in every culture want honesty, foresight and competence. But no trait is in all 29, and some of the most effective leaders, Marshall, Eisenhower and Merkel among them, succeeded without the charisma people expect.</p></div>
          <div><p class="q">Did styles change over the century?</p><p class="a">Yes. Commanding and hands-off styles drop out after 1990; coaching, democratic and affiliative styles spread. Research moved the same way, from command and control toward coaching and empathy.</p></div>
          <div><p class="q">Did the traits change?</p><p class="a">Much less. The core is present in every period. The clearest rise is adaptability, which most leaders since 1990 show. Empathy rose modestly. What changed most is how the core shows up: patience instead of defiance, a livestream instead of a podium.</p></div>
          <div><p class="q">What explains their failures?</p><p class="a">Usually the leader’s greatest strength pushed too far, or a blind spot outside the main mission. Every profile has real failures in it.</p></div>
        </div>
        <div class="people">
          <article class="card person"><p class="label muted">Borrow</p><h3 class="h3">Be trustworthy and clear about direction</h3><p class="small">That is what followers ask for in every survey and every culture, more than brilliance or charm.</p></article>
          <article class="card person"><p class="label muted">Borrow</p><h3 class="h3">Have more than one style</h3><p class="small">Goleman’s best leaders used four or more. Churchill’s style suited 1940 and misfired for years before it.</p></article>
          <article class="card person"><p class="label muted">Watch for</p><h3 class="h3">Your strength, overused</h3><p class="small">Ask what your best trait looks like at twice the strength. That is where your biggest mistake is likely to come from.</p></article>
        </div>
        <div class="card doom">
          <p class="label">Read this with care</p>
          <p class="small">Twenty-nine leaders chosen because they succeeded is a small, hindsight sample; many people with the same traits failed and were forgotten. The same flaw caught Collins’s Good to Great. The styles and trait marks are our judgment from the sources. Treat the patterns as strong hints, not laws.</p>
        </div>
      </section>

      <section class="sources">
        <p class="label">Sources</p>
        <ol>
          <li>Research: Robert House et al., <em>Culture, Leadership, and Organizations: The GLOBE Study of 62 Societies</em> (2004); James Kouzes and Barry Posner, <em>The Leadership Challenge</em> and “Characteristics of Admired Leaders” surveys; Timothy Judge, Joyce Bono, Remus Ilies and Megan Gerhardt, <em>Journal of Applied Psychology</em> (2002); Jim Collins, <em>Harvard Business Review</em> (2001) and <em>Good to Great</em>; Daniel Goleman, <em>Harvard Business Review</em> (2000); Gallup, <em>State of the Global Workplace</em>; Google re:Work, Project Oxygen; Lewin, Lippitt and White (1939); Greenleaf (1970); Burns (1978); McGregor (1960).</li>
          <li>Gandhi: Britannica; National Archives of India; accounts of the Poona Pact and of Ambedkar’s criticism.</li>
          <li>Roosevelt, Eisenhower, Reagan: American Presidency Project; Miller Center; National Archives on Executive Order 9066; Fred Greenstein, <em>The Hidden-Hand Presidency</em>.</li>
          <li>Marshall: George C. Marshall Foundation; U.S. Army Center of Military History; Nobel Prize records.</li>
          <li>Churchill: International Churchill Society; Imperial War Museums.</li>
          <li>Oppenheimer: Los Alamos National Laboratory; U.S. Department of Energy (2022 order); OSTI Manhattan Project history; National Park Service; Britannica.</li>
          <li>Wooden: UCLA Athletics; NCAA records. Ferguson: Anita Elberse, “Ferguson’s Formula,” <em>Harvard Business Review</em> (2013); Premier League records.</li>
          <li>King: Stanford King Institute. Mandela: Nelson Mandela Foundation; PBS <em>Frontline</em>. Maathai: Green Belt Movement; Nobel Prize records; BBC.</li>
          <li>Lee Kuan Yew: World Bank data; Transparency International; Freedom House; Reporters Without Borders.</li>
          <li>Walton: Walmart corporate history; <em>Made in America</em> (1992). Morita: Sony corporate history; <em>Made in Japan</em> (1986). Buffett: Berkshire Hathaway shareholder letters. Kelleher: Southwest Airlines; <em>Fortune</em> and <em>Dallas Morning News</em> (2022) on the holiday meltdown.</li>
          <li>Graham: <em>Personal History</em> (Pulitzer Prize, 1998); PBS NewsHour; NPR; Smithsonian; <em>TIME</em>. Hesselbein: Girl Scouts of the USA; <em>Christian Science Monitor</em> (1992); <em>Psychology Today</em> (2022); University of Pittsburgh archives.</li>
          <li>Thatcher: Margaret Thatcher Foundation. Welch: <em>Fortune</em>; NPR; GE. Winfrey: <em>TIME</em>; <em>Forbes</em>. Jobs: Britannica. Bezos: Amazon shareholder letters; FTC (2023).</li>
          <li>Merkel: Harvard Program on Negotiation; <em>Fortune</em> (2024). Nooyi: PepsiCo annual reports; <em>Fortune</em>. Barra: GM; U.S. Department of Justice (2015); NHTSA. Nadella: Microsoft; Stanford GSB. Ardern: RNZ; NPR (2023).</li>
          <li>Communication data: Daniel Hallin (1992); Smart Politics, University of Minnesota.</li>
        </ol>
        <p class="small">All text is an original summary of the sources. Style labels and trait marks are editorial judgments. No photographs of the people profiled are used.</p>
      </section>
    </div>
  </div>
  <Subscribe />
</Base>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  const show = (id: string, scroll = false) => {
    if (id.startsWith('p-')) id = 'leaders';
    if (!panels.some((p) => p.dataset.panel === id)) id = 'findings';
    panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
    tabs.forEach((t) => (t.dataset.tab === id ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
    if (scroll) document.querySelector('.art')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
  tabs.forEach((t) => t.addEventListener('click', (e) => { e.preventDefault(); history.replaceState(null, '', `#${t.dataset.tab}`); show(t.dataset.tab!, true); }));
  document.querySelectorAll<HTMLAnchorElement>('[data-goto]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); history.replaceState(null, '', `#${a.dataset.goto}`); show(a.dataset.goto!, true); }));
  const initial = location.hash.slice(1);
  show(initial || 'findings');
  if (initial.startsWith('p-')) window.dispatchEvent(new CustomEvent('leader-jump', { detail: initial.slice(2) }));
  window.addEventListener('hashchange', () => show(location.hash.slice(1) || 'findings'));
  // Registered before LeaderTable's listener runs its scroll, so the panel is visible first.
  window.addEventListener('leader-jump', () => { history.replaceState(null, '', '#leaders'); show('leaders'); }, { capture: true });
</script>

<style>
  .hero { background: #F1EEE7; border-bottom: 1px solid var(--line); }
  .hero-in { padding-block: 104px 72px; display: flex; flex-direction: column; gap: 28px; }
  .hero .label { color: var(--accent-ink); }
  .t-title { margin: 0; font-weight: 300; font-size: clamp(44px, 6.4vw, 96px); line-height: .98; letter-spacing: -0.03em; color: var(--ink); }
  .t-title .it { display: block; font-family: var(--serif); font-style: italic; color: var(--clay); font-size: .55em; margin-top: 12px; }
  .t-dek { margin: 0; max-width: 800px; font-family: var(--serif); font-weight: 300; font-size: clamp(21px, 2.2vw, 28px); line-height: 1.4; color: var(--ink-2); }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); border-top: 1px solid var(--line); margin-top: 4px; }
  .stats div { padding: 20px 16px 0 0; display: flex; flex-direction: column; gap: 4px; }
  .stats .n { font-size: 40px; font-weight: 300; color: var(--ink); }
  .stats .l { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted-2); }

  .art { display: flex; flex-wrap: wrap; gap: 56px; padding-block: 72px 96px; align-items: flex-start; }
  .rail { flex: 0 0 210px; position: sticky; top: 24px; display: flex; flex-direction: column; gap: 4px; }
  .rail-head { margin-bottom: 8px; }
  .rail-tab { display: grid; grid-template-columns: 28px 1fr; grid-template-rows: auto auto; column-gap: 8px; padding: 12px 14px; border-radius: 14px; text-decoration: none; color: var(--ink); border: 1px solid transparent; }
  .rail-tab:hover { background: var(--ground-2); color: var(--ink); }
  .rail-tab[aria-current='true'] { background: var(--ink); color: var(--ground); }
  .rail-n { grid-row: 1 / 3; font-family: var(--mono); font-size: 11px; opacity: .6; padding-top: 4px; }
  .rail-l { font-size: 18px; font-weight: 400; }
  .rail-s { font-family: var(--mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; opacity: .65; }
  @media (max-width: 900px) {
    .rail { flex-basis: 100%; flex-direction: row; overflow-x: auto; top: 0; z-index: 5; background: var(--ground); padding: 8px 0; gap: 6px; }
    .rail-head { display: none; }
    .rail-tab { flex: 0 0 auto; display: flex; flex-direction: column; gap: 0; border-color: var(--line); padding: 8px 14px; }
    .rail-n, .rail-s { display: none; }
    .rail-l { font-size: 15px; }
  }
  .panels { flex: 1 1 600px; min-width: 0; display: flex; flex-direction: column; gap: 56px; }
  .panel { display: flex; flex-direction: column; gap: 22px; }
  .panel[hidden] { display: none; }
  .gap-top { margin-top: 28px; }
  .muted-p { color: var(--muted); margin: -8px 0 0; }
  .pull { margin: 12px 0 0; padding-left: 24px; border-left: 2px solid var(--accent); font-family: var(--serif); font-style: italic; font-size: 26px; line-height: 1.35; }

  .glossary { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  .gcard { background: var(--card, #FBFAF7); border: 1px solid var(--line); border-top: 3px solid var(--accent); padding: 16px 18px; display: flex; flex-direction: column; gap: 6px; }
  .gcard h4 { margin: 0; font-family: var(--display); font-weight: 400; font-size: 24px; color: var(--ink); }
  .gcard p { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--ink-2); }
  .gcard .g-src { font-family: var(--mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted-2); }

  .era-filter { display: flex; flex-wrap: wrap; gap: 8px; }
  .era-filter .chip { cursor: pointer; font: inherit; font-size: 13px; }
  .era-filter .chip.on { background: var(--ink); color: var(--ground); border-color: var(--ink); }
  .lcards { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
  .lcard { padding: 24px; display: flex; flex-direction: column; gap: 12px; transition: box-shadow .4s ease; }
  .lcard[hidden] { display: none; }
  .lcard.flash { box-shadow: 0 0 0 3px var(--accent); }
  .lcard .h3 { margin: 0; }
  .lcard .label { margin: 0; }
  .stags { display: flex; flex-wrap: wrap; gap: 6px; }
  .stag { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--clay); color: var(--clay); cursor: help; }
  .stag.main { background: var(--clay); color: #F6F4EF; }
  .tchips { display: flex; flex-wrap: wrap; gap: 5px; }
  .tchip { font-size: 12px; padding: 3px 9px; border-radius: 4px; background: var(--ground-2); color: var(--ink-2); }
  .sl { display: flex; flex-direction: column; gap: 4px; border-top: 1px solid var(--line); padding-top: 10px; }
  .sl-h { margin: 6px 0 0; font-family: var(--mono); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; }
  .sl-h.ok { color: #3D6B4A; } .sl-h.bad { color: #9A3B24; } .sl-h.mix { color: var(--accent-ink); }
  .sl ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 5px; }
  .sl li { position: relative; padding-left: 22px; font-size: 15px; line-height: 1.45; color: var(--ink-2); }
  .sl ul.ok li::before { content: '✓'; position: absolute; left: 2px; top: 0; color: #3D6B4A; font-weight: 600; }
  .sl ul.bad li::before { content: '✕'; position: absolute; left: 2px; top: 0; color: #9A3B24; font-weight: 600; }
  .mixp { margin: 0; font-size: 15px; line-height: 1.45; color: var(--ink-2); padding-left: 22px; position: relative; }
  .mixp::before { content: '◐'; position: absolute; left: 0; color: var(--accent-ink); }
  .ltalk { margin: auto 0 0; padding-top: 10px; border-top: 1px dashed var(--line); font-family: var(--serif); font-style: italic; font-size: 16px; color: var(--muted); }
  .ltalk span { display: block; font-family: var(--mono); font-style: normal; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted-2); margin-bottom: 2px; }

  .findings { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 14px; }
  .find { padding: 22px; display: flex; flex-direction: column; gap: 8px; }
  .find .label { margin: 0; color: var(--accent-ink); }
