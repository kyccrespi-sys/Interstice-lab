---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroTree from '../components/HeroTree.astro';
import Subscribe from '../components/Subscribe.astro';
import { site } from '../data/site';
import { inline, toRoman } from '../data/inline';

const all = (await getCollection('frameworks')).sort((a, b) => a.data.course - b.data.course);
const featured = all.find((f) => f.data.featured && f.data.status === 'published') ?? all[0];
const fieldsOfStudy = ['Biotechnology', 'Ecology', 'Economics', 'Finance', 'Material science', 'Design & policy'];
const researchers = featured.data.lineage.map((l) => l.by.split(' · ')[0]);
---
<Base>
  <!-- HERO -->
  <section class="wrap hero">
    <div class="hero-copy">
      <p class="label">{site.volume}</p>
      <h1 class="h1">Knowledge branches apart. We help it <span class="it honey">grow back together.</span></h1>
      <p class="lede">Welcome. We read across biotechnology, ecology, economics and finance — peer-reviewed research and the best long-form writing on nature — and synthesize what we find into new frameworks that industries can actually build on.</p>
      <div class="row">
        <a href="#frameworks" class="btn btn-honey">Explore frameworks</a>
        <a href="#method" class="btn btn-line">How we synthesize</a>
      </div>
    </div>
    <div class="hero-art">
      <HeroTree />
      <p class="label muted fig-cap">Fig. 01 — Specimen: a network of ideas</p>
    </div>
  </section>

  <!-- EDITORIAL STATEMENT -->
  <section class="wrap statement" aria-label="Editorial statement">
    <p class="label statement-label">Editorial statement</p>
    <div class="statement-body">
      <p class="statement-text">Every discipline grows outward, away from the others, until the people who could answer each other's questions no longer share a language. <span class="it honey">Interstice Lab lives in the space between.</span></p>
      <p class="body muted-body">We are slow on purpose. Each season we read deeply, credit generously and serve a small number of frameworks — carefully prepared, with every source on the table.</p>
      <p class="label muted">— {site.editor}, Editor</p>
    </div>
  </section>

  <!-- FIELDS -->
  <section class="fields" aria-label="Fields we draw from">
    <div class="wrap fields-grid">
      {fieldsOfStudy.map((f, i) => (
        <div class="field"><span class="field-num">0{i + 1}</span><span class="field-name">{f}</span></div>
      ))}
    </div>
  </section>

  <!-- FEATURED -->
  <section id="frameworks" class="wrap section stack-lg">
    <div class="split-head">
      <h2 class="h2">Featured framework</h2>
      <p class="label muted">Course {toRoman(featured.data.course)} of the season</p>
    </div>
    <article class="feature card">
      <div class="feature-main">
        <p class="label">Framework {featured.data.number} · {featured.data.category}</p>
        <h3 class="feature-title">{featured.data.title} {featured.data.titleAccent}</h3>
        <p class="feature-q">{featured.data.question}</p>
        <p class="small">{featured.data.summary}</p>
        <a href={`/frameworks/${featured.id}/`} class="link-arrow">Read the framework →</a>
      </div>
      <div class="feature-side">
        <div class="side-block">
          <p class="label muted">Draws on</p>
          <div class="chips">{featured.data.fields.map((f) => <span class="chip">{f}</span>)}</div>
        </div>
        {featured.data.appliesTo.length > 0 && (
          <div class="side-block">
            <p class="label muted">Applies to</p>
            <p class="small ink">{featured.data.appliesTo.map((a) => a.name).join(' · ')}</p>
          </div>
        )}
        {featured.data.lineage.length > 0 && (
          <div class="side-block">
            <p class="label muted">Key sources</p>
            <ol class="side-list">
              {featured.data.lineage.map((l) => <li><em>{l.work}</em> — {l.by.split(' · ')[0]}, {l.year}</li>)}
            </ol>
          </div>
        )}
      </div>
    </article>
  </section>

  <!-- THE SEASON -->
  <section id="season" class="band">
    <div class="season section">
      <div class="season-head">
        <p class="label">The Season · {site.season}</p>
        <h2 class="season-title it">A synthesis in {all.length} courses</h2>
        <p class="small">Read in order, each framework prepares the palate for the next. Every course names the researchers and writers whose work it grows from.</p>
      </div>
      <ol class="menu">
        {all.map((f) => (
          <li class="menu-item">
            <span class="menu-num it">{toRoman(f.data.course)}.</span>
            <div class="menu-main">
              {f.data.status === 'published'
                ? <a href={`/frameworks/${f.id}/`} class="menu-title">{f.data.title} {f.data.titleAccent}</a>
                : <span class="menu-title">{f.data.title} {f.data.titleAccent}</span>}
              <span class="menu-pair it">{f.data.pairing}</span>
            </div>
            <span class="label muted">{f.data.status === 'published' ? f.data.fields.slice(0, 2).join(' · ') : 'Forthcoming'}</span>
          </li>
        ))}
      </ol>
      <div class="season-credits">
        <p class="label muted">With gratitude to the researchers this season</p>
        <p class="credits it">{researchers.join(' · ')} · and the researchers behind the courses to come</p>
      </div>
      <a href={`/frameworks/${featured.id}/`} class="btn btn-honey">Begin the first course</a>
    </div>
  </section>

  <!-- METHOD -->
  <section id="method" class="wrap section stack-xl">
    <div class="stack-md max-760">
      <p class="label">Method</p>
      <h2 class="h2">Like a vascular network, synthesis <span class="it">lives in its connections.</span></h2>
    </div>
    <div class="method-grid">
      <div class="method">
        <svg width="48" height="52" viewBox="0 0 48 52" aria-hidden="true"><path d="M24 50 L24 30 M24 30 L12 10 M24 30 L36 10" stroke="#A8432C" stroke-width="1.8" fill="none" stroke-linecap="round"></path></svg>
        <h3 class="h3">01 — Root</h3>
        <p class="small">We gather from peer-reviewed journals, preprint servers, working-paper series and the strongest long-form writing on nature and culture.</p>
      </div>
      <div class="method">
        <svg width="48" height="52" viewBox="0 0 48 52" aria-hidden="true"><path d="M24 50 L24 30 M24 30 C 12 26, 10 14, 14 6 M24 30 C 36 26, 38 14, 34 6" stroke="#A8432C" stroke-width="1.8" fill="none" stroke-linecap="round"></path><path d="M14 6 Q24 0 34 6" stroke="#E8A33D" stroke-width="1.6" stroke-dasharray="2 2" fill="none"></path></svg>
        <h3 class="h3">02 — Branch</h3>
        <p class="small">We trace each field outward and map shared principles across fields — feedback, symbiosis, decay, redundancy — and look for where one discipline answers another's open question.</p>
      </div>
      <div class="method">
        <svg width="48" height="52" viewBox="0 0 48 52" aria-hidden="true"><path d="M24 50 L24 30 M24 30 C 12 26, 10 14, 14 6 M24 30 C 36 26, 38 14, 34 6 M24 30 L24 14" stroke="#A8432C" stroke-width="1.8" fill="none" stroke-linecap="round"></path><circle cx="14" cy="6" r="3.5" fill="#E8A33D"></circle><circle cx="34" cy="6" r="3.5" fill="#E8A33D"></circle><circle cx="24" cy="12" r="3.5" fill="#E8A33D"></circle></svg>
        <h3 class="h3">03 — Reconnect</h3>
        <p class="small">Each synthesis becomes a framework: the idea, the evidence behind it, and how a specific industry could put it to work. Every claim links back to its source.</p>
      </div>
    </div>
  </section>

  <!-- SOURCES -->
  <section class="sources-band">
    <div class="wrap sources-row">
      <p class="label muted">We read from</p>
      <div class="sources-list it">
        <span>Peer-reviewed journals</span><span>Preprint servers</span><span>Working-paper series</span><span>Long-form ecological writing</span><span>Open scholarly databases</span>
      </div>
    </div>
  </section>

  <Subscribe />
</Base>

<style>
  .row { display: flex; flex-wrap: wrap; gap: 16px; }
  .stack-lg { display: flex; flex-direction: column; gap: 48px; }
  .stack-xl { display: flex; flex-direction: column; gap: 64px; }
  .stack-md { display: flex; flex-direction: column; gap: 20px; }
  .max-760 { max-width: 760px; }
  .split-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 24px; }

  .hero { padding-block: 88px 96px; display: flex; flex-wrap: wrap; align-items: center; gap: 56px; }
  .hero-copy { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 32px; }
  .hero-art { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .fig-cap { align-self: flex-start; font-size: 12px; }

  .statement { padding-block: 24px 104px; display: flex; flex-wrap: wrap; gap: 40px; }
  .statement-label { flex: 0 1 220px; padding-top: 14px; }
  .statement-body { flex: 1 1 640px; min-width: 0; display: flex; flex-direction: column; gap: 28px; }
  .statement-text { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(28px, 3vw, 42px); line-height: 1.3; }
  .muted-body { color: var(--muted); max-width: 680px; }

  .fields { border-block: 1px solid var(--line); }
  .fields-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  .field { padding: 28px 0; display: flex; flex-direction: column; gap: 6px; }
  .field-num { font-family: var(--mono); font-size: 12px; color: var(--accent-ink); }
  .field-name { font-size: 20px; }

  .feature { display: flex; flex-wrap: wrap; overflow: hidden; border-radius: 28px; box-shadow: 0 24px 60px -30px rgba(138,90,18,0.35); }
  .feature-main { flex: 1 1 520px; min-width: 0; padding: 48px; display: flex; flex-direction: column; gap: 28px; border-right: 1px solid var(--line); }
  .feature-title { margin: 0; font-weight: 300; font-size: clamp(32px, 3.4vw, 48px); line-height: 1.08; letter-spacing: -0.02em; }
  .feature-q { margin: 0; font-family: var(--serif); font-style: italic; font-size: 24px; line-height: 1.4; color: var(--ink-2); }
  .feature-side { flex: 1 1 340px; min-width: 0; padding: 48px; display: flex; flex-direction: column; gap: 32px; }
  .side-block { display: flex; flex-direction: column; gap: 12px; }
  .ink { color: var(--ink); }
  .side-list { margin: 0; padding-left: 20px; font-family: var(--serif); font-size: 16px; line-height: 1.6; color: var(--ink-2); }
  @media (max-width: 640px) { .feature-main, .feature-side { padding: 28px; } }

  .season { max-width: 880px; margin: 0 auto; padding-inline: 40px; display: flex; flex-direction: column; align-items: center; gap: 56px; }
  .season-head { display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; max-width: 600px; }
  .season-title { margin: 0; font-size: clamp(40px, 4.6vw, 64px); line-height: 1.05; }
  .menu { list-style: none; margin: 0; padding: 0; width: 100%; }
  .menu-item { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 24px; padding: 28px 0; border-top: 1px solid rgba(35,32,26,0.16); }
  .menu-item:last-child { border-bottom: 1px solid rgba(35,32,26,0.16); }
  .menu-num { flex: 0 0 56px; font-size: 22px; color: var(--clay); }
  .menu-main { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .menu-title { font-size: 24px; font-weight: 400; letter-spacing: -0.01em; color: var(--ink); text-decoration: none; }
  a.menu-title:hover { color: var(--accent-ink); }
  .menu-pair { font-size: 17px; color: var(--muted); }
  .season-credits { display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; }
  .credits { margin: 0; max-width: 640px; font-size: 18px; line-height: 1.6; color: var(--ink-2); }
  @media (max-width: 640px) { .season { padding-inline: 20px; } }

  .method-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 40px; }
  .method { display: flex; flex-direction: column; gap: 16px; }

  .sources-band { border-top: 1px solid var(--line); }
  .sources-row { padding-block: 72px; display: flex; flex-wrap: wrap; gap: 40px; align-items: baseline; justify-content: space-between; }
  .sources-list { flex: 1 1 700px; min-width: 0; display: flex; flex-wrap: wrap; gap: 16px 48px; font-size: 26px; color: var(--ink-2); }
</style>
