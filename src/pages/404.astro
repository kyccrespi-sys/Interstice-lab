---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="narrow nf">
    <p class="label">404</p>
    <h1 class="h1">This branch <span class="it honey">doesn’t reconnect.</span></h1>
    <p class="lede">The page you’re looking for isn’t here.</p>
    <a href="/" class="btn btn-honey">Back to the season</a>
  </section>
</Base>

<style>
  .nf { padding-block: 120px; display: flex; flex-direction: column; gap: 28px; align-items: flex-start; }
</style>
