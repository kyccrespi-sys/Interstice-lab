---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/#season', label: 'The Season' },
  { href: '/frameworks/', label: 'Frameworks' },
  { href: '/#method', label: 'Method' },
  { href: '/curiosity/', label: 'Curiosity Corner' },
  { href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#FBF7EF" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a href="/" class="brand" aria-label={`${site.name} home`}>
          <Logo />
          <span class="wordmark">
            <span class="wm-name">INTERSTICE</span>
            <span class="wm-rule" aria-hidden="true"></span>
            <span class="wm-lab">LAB</span>
          </span>
        </a>
        <nav aria-label="Primary" class="nav">
          {nav.map((n) => (
            <a href={n.href} aria-current={path === n.href || (n.href === '/curiosity/' && path.startsWith('/curiosity')) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <a href="#subscribe" class="btn btn-honey">Subscribe</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-row">
        <span>{site.name} — {site.tagline}</span>
        <span>© {new Date().getFullYear()} {site.name} · Summaries link to original sources</span>
      </div>
    </footer>
    <script>
      // Fade sections and cards in as they scroll into view.
      const targets = document.querySelectorAll('main section > *, .card, .menu-item, .principle, .lineage-card, .apply-row');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px' });
      targets.forEach((el) => {
        const sibs = el.parentElement ? Array.from(el.parentElement.children) : [];
        (el as HTMLElement).style.setProperty('--stagger', `${Math.min(sibs.indexOf(el), 6) * 70}ms`);
        el.classList.add('reveal');
        io.observe(el);
      });
    </script>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--line); background: var(--ground); }
  .header-row { padding-block: 24px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; }
  .brand { display: flex; align-items: center; gap: 14px; text-decoration: none; color: var(--ink); }
  .wordmark { display: flex; align-items: center; gap: 12px; }
  .wm-name { font-family: var(--sans); font-size: 17px; font-weight: 500; letter-spacing: 0.32em; }
  .wm-rule { width: 1px; height: 16px; background: rgba(35,32,26,0.35); }
  .wm-lab { font-family: var(--mono); font-size: 11px; letter-spacing: 0.24em; color: var(--muted-2); }
  .nav { display: flex; flex-wrap: wrap; gap: 28px; font-family: var(--mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; }
  .nav a { color: var(--muted); text-decoration: none; padding-block: 12px; }
  .nav a:hover, .nav a[aria-current='page'] { color: var(--ink); }
  .site-footer { border-top: 1px solid var(--line); }
  .footer-row { padding-block: 48px 56px; display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted-2); }
  @media (max-width: 760px) { .nav { gap: 18px; order: 3; width: 100%; } }
  @media (max-width: 480px) { .wm-rule, .wm-lab { display: none; } .wm-name { letter-spacing: 0.24em; font-size: 15px; } .header-row .btn { min-height: 44px; padding: 0 18px; } }
</style>
